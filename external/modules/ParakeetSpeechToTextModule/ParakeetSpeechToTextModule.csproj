<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ParakeetSpeechToTextModule</AssemblyName>
    <RootNamespace>AvatarBuilder.Modules.Audio.ParakeetSpeechToText</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
    <ProjectReference Include="..\SpeechToTextModule\SpeechToTextModule.csproj" />
    <ProjectReference Include="..\SpeakerRecognitionModule\SpeakerRecognitionModule.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('models\sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8')">
    <Content Include="models\sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8\**\*">
      <Link>dependencies\audio\parakeet\sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
