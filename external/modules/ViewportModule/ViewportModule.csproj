<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ViewportModule</AssemblyName>
    <RootNamespace>AvatarBuilder.Modules.Viewports</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ModuleContracts\ModuleContracts.csproj" />
    <ProjectReference Include="..\CameraModule\CameraModule.csproj" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Shaders\PreviewBgra.hlsl">
      <LogicalName>ViewportModule.Shaders.PreviewBgra.hlsl</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Shaders\PreviewNv12.hlsl">
      <LogicalName>ViewportModule.Shaders.PreviewNv12.hlsl</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
