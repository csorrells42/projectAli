<Window x:Class="Ali.App.Wpf.DarkConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TitleText}"
        Height="250"
        Width="520"
        MinHeight="230"
        MinWidth="480"
        MaxHeight="320"
        MaxWidth="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B0B0D"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#323236" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Padding="18"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushDark}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding TitleText}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1"
                       Text="{Binding MessageText}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="14"
                       LineHeight="21"
                       Margin="0,12,0,18"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding CancelText}"
                        IsCancel="True"
                        Click="CancelButton_OnClick" />
                <Button Content="{Binding ConfirmText}"
                        Background="#2A1517"
                        BorderBrush="#7F1D1D"
                        IsDefault="False"
                        Click="ConfirmButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
