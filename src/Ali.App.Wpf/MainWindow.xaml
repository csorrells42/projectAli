<Window x:Class="Ali.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Ali.App.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Ali"
        Height="820"
        MinHeight="640"
        Width="1320"
        MinWidth="1080"
        Background="#0B0B0D"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0D" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#121214" />
        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202024" />
        <SolidColorBrush x:Key="InputBrush" Color="#0F0F11" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#323236" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9DA4AE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00BEE6" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="ComposerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="#2F2F32" />
            <Setter Property="BorderBrush" Value="#3B3B40" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SidebarActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style x:Key="ResourceMeterProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="#22C55E" />
            <Setter Property="Background" Value="#303136" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Ali" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Local assistant" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,14" />

                    <Button Content="New chat"
                            Command="{Binding NewChatCommand}"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8" />
                    <Border Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,0,0,12">
                        <TextBlock Text="Search chats (coming later)"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </Border>

                    <TextBlock Text="Recents" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <ListBox ItemsSource="{Binding ConversationHistory}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             MaxHeight="420">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConversationHistoryItemViewModel}">
                                <Border Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8,5"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsViewing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <DockPanel Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button DockPanel.Dock="Right"
                                                    Content="OK"
                                                    Command="{Binding DataContext.CommitConversationRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Height="26"
                                                    MinHeight="26"
                                                    Padding="8,0"
                                                    Margin="6,0,0,0" />
                                            <TextBox Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"
                                                     MinHeight="26"
                                                     Margin="0"
                                                     Padding="6,3" />
                                        </DockPanel>

                                        <Button Grid.Column="1"
                                                Content="..."
                                                Style="{StaticResource SidebarActionButton}"
                                                Click="HistoryMenuButton_OnClick"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Chat actions">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Rename"
                                                              Command="{Binding PlacementTarget.Tag.RenameConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Erase chat"
                                                              Command="{Binding PlacementTarget.Tag.EraseConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="Erase History"
                            Command="{Binding EraseHistoryCommand}"
                            HorizontalContentAlignment="Center"
                            Margin="0,8,0,0"
                            BorderBrush="#7F1D1D"
                            Background="#2A1517"
                            ToolTip="Clear the visible chat, current-session history, transcript text, and temporary attachments." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,18,30,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="44"
                    Margin="0,0,0,10"
                    Padding="14,0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Ali"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="12,0,14,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="2"
                                  ItemsSource="{Binding ResourceMeters}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ResourceMeterViewModel}">
                                <Border Width="58"
                                        Margin="0,0,6,0"
                                        ToolTip="{Binding ToolTip}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding Label}"
                                                       DockPanel.Dock="Left"
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayText}"
                                                       DockPanel.Dock="Right"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}"
                                                     Style="{StaticResource ResourceMeterProgress}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="3"
                            x:Name="RuntimeSettingsButton"
                            Content="Runtime"
                            Click="RuntimeSettingsButton_OnClick"
                            Height="34"
                            MinHeight="34"
                            Margin="0,0,8,0"
                            Padding="12,0"
                            ToolTip="{Binding RuntimeDisplay}"
                            VerticalAlignment="Center" />
                    <Popup x:Name="RuntimeSettingsPopup"
                           Grid.Column="3"
                           PlacementTarget="{Binding ElementName=RuntimeSettingsButton}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="False">
                        <Border Width="430"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Runtime Settings"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding RuntimeDisplay}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,8" />
                                <TextBlock Text="{Binding ActiveRuntimeStatus}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Endpoint" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RuntimeEndpointText, UpdateSourceTrigger=PropertyChanged}" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Installed model" Style="{StaticResource FieldLabel}" />
                                    <Button DockPanel.Dock="Right"
                                            Content="Refresh"
                                            Command="{Binding RefreshRuntimeModelsCommand}"
                                            Padding="8,5"
                                            Margin="8,0,0,0" />
                                </DockPanel>
                                <ComboBox ItemsSource="{Binding RuntimeModelChoices}"
                                          SelectedItem="{Binding SelectedRuntimeModelChoice}"
                                          Margin="0,2,0,8" />
                                <TextBlock Text="{Binding RuntimeSelectionStatusText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Quantization" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding RuntimeQuantizationChoices}"
                                          SelectedItem="{Binding RuntimeQuantizationText}"
                                          Margin="0,2,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Context" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding RuntimeContextChoices}"
                                                  SelectedItem="{Binding RuntimeContextText}"
                                                  Margin="0,2,0,8" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Output" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding RuntimeOutputLimitChoices}"
                                                  SelectedItem="{Binding RuntimeOutputLimitText}"
                                                  Margin="0,2,0,8" />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="4">
                                    <Button Content="Save" Command="{Binding SaveRuntimeSettingsCommand}" Margin="0,0,5,0" />
                                    <Button Content="Check" Command="{Binding CheckRuntimeCommand}" Margin="5,0,5,0" />
                                    <Button Content="Activate"
                                            Command="{Binding ActivateRuntimeCommand}"
                                            IsEnabled="{Binding CanActivateRuntime}"
                                            Margin="5,0,5,0" />
                                    <Button Content="Stub" Command="{Binding RevertToStubCommand}" Margin="5,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Grid.Column="4"
                            Content="Voice Settings"
                            Command="{Binding OpenVoiceSettingsCommand}"
                            Height="34"
                            MinHeight="34"
                            Margin="0"
                            Padding="12,0"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="MessagesScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,8,0,8">
                <ItemsControl ItemsSource="{Binding Messages}" MaxWidth="840" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                            <StackPanel Margin="0,0,0,18">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding RoleName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding EvidenceStatus}"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               FontSize="12" />
                                </DockPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="15" LineHeight="22" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Flag as incorrect"
                                            Command="{Binding DataContext.FlagIncorrectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Height="28"
                                            MinHeight="28"
                                            Margin="0"
                                            Padding="9,0"
                                            FontSize="12"
                                            Visibility="{Binding CanFlagAsIncorrect, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="Flagged for correction"
                                               Margin="8,6,0,0"
                                               Foreground="#FBBF24"
                                               FontSize="12"
                                               Visibility="{Binding IsFlaggedForCorrection, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ImageAttachmentViewModel}">
                            <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,8,8" Width="150">
                                <StackPanel>
                                    <Image Source="{Binding FilePath}" Height="74" Stretch="Uniform" />
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                                    <CheckBox Content="Retain" IsChecked="{Binding RetainAfterSession}" Margin="0,4,0,0" />
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1"
                        Background="#242426"
                        BorderBrush="#38383D"
                        BorderThickness="1"
                        CornerRadius="26"
                        Padding="8"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="+"
                                Command="{Binding PasteImageCommand}"
                                ToolTip="Attach an image from the clipboard"
                                Style="{StaticResource ComposerButton}" />

                        <TextBox x:Name="ComposerTextBox"
                                 Grid.Column="1"
                                 MinHeight="44"
                                 MaxHeight="150"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="6,0"
                                 Padding="8,10"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="ComposerTextBox_OnKeyDown" />

                        <Button Grid.Column="2"
                                Content="{Binding MicButtonText}"
                                Command="{Binding ToggleVoiceRecordingCommand}"
                                ToolTip="Record speech into the chat bar"
                                Style="{StaticResource ComposerButton}" />
                        <Button Grid.Column="3"
                                Content="{Binding VoiceModeButtonText}"
                                Command="{Binding ToggleVoiceModeCommand}"
                                ToolTip="Toggle hands-free voice mode"
                                Style="{StaticResource ComposerButton}"
                                MinWidth="96" />
                        <Button Grid.Column="4"
                                Content="Stop"
                                Command="{Binding StopCommand}"
                                ToolTip="Stop the current response"
                                Style="{StaticResource ComposerButton}" />
                        <Button Grid.Column="5"
                                Content="Send"
                                Command="{Binding SendCommand}"
                                ToolTip="Send chat"
                                Style="{StaticResource ComposerButton}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="6,8,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AttachmentStatus}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding VoiceStatus}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
