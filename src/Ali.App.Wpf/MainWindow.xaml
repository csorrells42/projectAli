<Window x:Class="Ali.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Ali.App.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Ali"
        Height="820"
        MinHeight="640"
        Width="1320"
        MinWidth="1080"
        Background="#F4F6F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Ali" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Local assistant" Foreground="#A7B0BE" Margin="0,2,0,20" />

                    <Button Content="Chat" HorizontalContentAlignment="Left" />
                    <Button Content="Sources &amp; Topics" HorizontalContentAlignment="Left" />
                    <Button Content="Memories" HorizontalContentAlignment="Left" />
                    <Button Content="Reminders" HorizontalContentAlignment="Left" />
                    <Button Content="Calendar" HorizontalContentAlignment="Left" />
                    <Button Content="Images" HorizontalContentAlignment="Left" />
                    <Button Content="Settings" HorizontalContentAlignment="Left" />
                    <Button Content="Feedback" HorizontalContentAlignment="Left" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#1F2937" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Runtime" Foreground="#9CA3AF" FontSize="12" />
                        <TextBlock Text="{Binding RuntimeDisplay}" Foreground="White" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Chat" FontSize="26" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock Text="{Binding StatusText}" Foreground="#4B5563" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#D6DAE0" BorderThickness="1" CornerRadius="8" Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                                <Border Padding="14"
                                        Margin="0,0,0,12"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="#DDE2EA">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F9FAFB" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RoleName}" Value="User">
                                                    <Setter Property="Background" Value="#EAF2FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RoleName}" Value="Assistant">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding RoleName}" FontWeight="SemiBold" Foreground="#111827" />
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding EvidenceStatus}"
                                                       Foreground="#6B7280"
                                                       FontSize="12" />
                                        </DockPanel>

                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#111827" />

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Flag as incorrect"
                                                    Command="{Binding DataContext.FlagIncorrectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanFlagAsIncorrect, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="Flagged for correction"
                                                       Margin="12,11,0,0"
                                                       Foreground="#B45309"
                                                       Visibility="{Binding IsFlaggedForCorrection, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Background="White" BorderBrush="#D6DAE0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,16,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding AttachmentStatus}" Foreground="#4B5563" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Paste Image" Command="{Binding PasteImageCommand}" Margin="0,0,8,0" />
                            <Button Content="Capture Screen" Command="{Binding CaptureScreenCommand}" Margin="0" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ImageAttachmentViewModel}">
                                <Border BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,8,8" Width="150">
                                    <StackPanel>
                                        <Image Source="{Binding FilePath}" Height="74" Stretch="Uniform" />
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#4B5563" Margin="0,6,0,0" />
                                        <CheckBox Content="Retain" IsChecked="{Binding RetainAfterSession}" Margin="0,4,0,0" />
                                        <Button Content="Remove"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Voice" FontWeight="SemiBold" Foreground="#111827" />
                                    <TextBlock Text="{Binding VoiceStatus}" Foreground="#4B5563" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Push to Talk" Command="{Binding StartVoiceRecordingCommand}" Margin="0,0,8,0" />
                                    <Button Content="Stop Recording" Command="{Binding StopVoiceRecordingCommand}" Margin="0,0,8,0" />
                                    <Button Content="Stop Speaking" Command="{Binding StopSpeakingCommand}" Margin="0,0,8,0" />
                                    <Button Content="Voice Settings" Command="{Binding OpenVoiceSettingsCommand}" Margin="0" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Input" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding VoiceInputDevices}" SelectedItem="{Binding SelectedVoiceInputDevice}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Channel" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding VoiceInputChannelModes}" SelectedItem="{Binding SelectedVoiceInputChannelMode}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Output" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding VoiceOutputDevices}" SelectedItem="{Binding SelectedVoiceOutputDevice}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Input preset" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding VoiceInputPresets}" SelectedItem="{Binding SelectedVoiceInputPreset}" Margin="0,2,0,6" />

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Height="12"
                                         Value="{Binding VoiceInputLevelPercent}"
                                         Margin="0,2,0,4" />
                            <TextBlock Text="{Binding VoiceInputMeterText}" Foreground="#4B5563" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Text="{Binding VoiceDiagnosticsText}" Foreground="#6B7280" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,6" />

                            <TextBlock Text="{Binding SttStatus}" Foreground="#4B5563" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Text="{Binding TtsStatus}" Foreground="#4B5563" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6" />

                            <TextBlock Text="Transcript" Style="{StaticResource FieldLabel}" />
                            <TextBox MinHeight="34"
                                     MaxHeight="82"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding EditableTranscript, UpdateSourceTrigger=PropertyChanged}" />
                            <DockPanel>
                                <TextBlock Text="{Binding LastTranscript}" Foreground="#6B7280" TextWrapping="Wrap" />
                                <Button DockPanel.Dock="Right"
                                        Content="Send Transcript"
                                        Command="{Binding SendTranscriptCommand}"
                                        Margin="8,0,0,0" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ComposerTextBox"
                                 MinHeight="46"
                                 MaxHeight="150"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 FontSize="15"
                                 Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="ComposerTextBox_OnKeyDown" />

                        <Button Grid.Column="1"
                                Content="Stop"
                                Margin="12,0,0,0"
                                Command="{Binding StopCommand}" />

                        <Button Grid.Column="2"
                                Content="Send"
                                Margin="8,0,0,0"
                                Command="{Binding SendCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Background="White" BorderBrush="#D6DAE0" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Runtime Settings" FontSize="20" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text="{Binding ActiveRuntimeStatus}" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,4,0,10" />

                        <CheckBox Content="Enable local OpenAI-compatible runtime"
                                  IsChecked="{Binding RuntimeEnabled}"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="Runtime endpoint" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RuntimeEndpointText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Model/package ID" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RuntimeModelText, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Context size" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RuntimeContextText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max output" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RuntimeOutputLimitText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RuntimeTemperatureText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Top-p" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RuntimeTopPText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Streaming enabled"
                                  IsChecked="{Binding RuntimeStreamingEnabled}"
                                  Margin="0,0,0,4" />

                        <CheckBox Content="Model supports images"
                                  IsChecked="{Binding RuntimeVisionEnabled}"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="Settings file" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding RuntimeSettingsPath}" TextWrapping="Wrap" Foreground="#4B5563" FontSize="12" Margin="0,2,0,10" />

                        <UniformGrid Columns="2" Margin="0,4,0,0">
                            <Button Content="Load settings" Command="{Binding LoadRuntimeSettingsCommand}" Margin="0,0,6,6" />
                            <Button Content="Save settings" Command="{Binding SaveRuntimeSettingsCommand}" Margin="6,0,0,6" />
                            <Button Content="Check Runtime" Command="{Binding CheckRuntimeCommand}" Margin="0,0,6,6" />
                            <Button Content="Activate Runtime"
                                    Command="{Binding ActivateRuntimeCommand}"
                                    IsEnabled="{Binding CanActivateRuntime}"
                                    Margin="6,0,0,6" />
                            <Button Content="Revert to Stub" Command="{Binding RevertToStubCommand}" Margin="0,0,6,6" />
                            <Button Content="Last Known Good"
                                    Command="{Binding RevertToLastKnownGoodCommand}"
                                    IsEnabled="{Binding CanRevertToLastKnownGood}"
                                    Margin="6,0,0,6" />
                        </UniformGrid>

                        <TextBlock Text="Last health check" FontWeight="SemiBold" Foreground="#111827" Margin="0,14,0,4" />
                        <TextBlock Text="{Binding RuntimeHealthResult}" TextWrapping="Wrap" Foreground="#4B5563" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
