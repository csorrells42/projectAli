<Window x:Class="Ali.App.Wpf.ProgrammingDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programming"
        Height="620"
        MinHeight="560"
        Width="980"
        MinWidth="860"
        Background="#0B0B0D"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202024" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#323236" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9DA4AE" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    Content="Close"
                    Click="CloseButtonClick"
                    MinWidth="82"
                    Margin="12,0,0,0" />
            <StackPanel>
                <TextBlock Text="Programming"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="Workspace review, validation, builds, tests, failure diagnosis, and safe patch previews."
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*" />
                <ColumnDefinition Width="1.08*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <UniformGrid Columns="1">
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Workspace"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Read-only checks before changing code."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,6" />
                            <WrapPanel>
                                <Button Content="Workspace"
                                        Command="{Binding RunCodingWorkspaceDiagnosticCommand}" />
                                <Button Content="Intelligence"
                                        Command="{Binding RunCodingProjectIntelligenceCommand}" />
                                <Button Content="Understand Repo"
                                        Command="{Binding RunCodingRepoUnderstandingCommand}" />
                                <Button Content="Context"
                                        Command="{Binding RunCodingContextPacketCommand}" />
                                <Button Content="Full Readiness"
                                        Command="{Binding RunCodingFullReadinessCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Mini-Codex"
                                        Command="{Binding RunCodingMiniCodexStatusCommand}" />
                                <Button Content="Health"
                                        Command="{Binding RunCodingHealthScoreCommand}" />
                                <Button Content="Git"
                                        Command="{Binding RunCodingGitStatusCommand}" />
                                <Button Content="Review"
                                        Command="{Binding RunCodingReviewChangesCommand}" />
                                <Button Content="Validate"
                                        Command="{Binding RunCodingValidationPlanCommand}" />
                                <Button Content="Safe Commit"
                                        Command="{Binding RunCodingSafeCommitCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Code Intelligence"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Roslyn-backed symbol, call, binding, and test-impact checks."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,6" />
                            <WrapPanel>
                                <Button Content="Symbols"
                                        Command="{Binding RunCodingSymbolIndexCommand}" />
                                <Button Content="Call Graph"
                                        Command="{Binding RunCodingCallGraphCommand}" />
                                <Button Content="Bindings"
                                        Command="{Binding RunCodingBindingCheckCommand}" />
                                <Button Content="Impacted Tests"
                                        Command="{Binding RunCodingImpactedTestsCommand}" />
                                <Button Content="Safe Edit"
                                        Command="{Binding RunCodingSafeEditWorkflowCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Build Loop"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Run confirmed validation, inspect failures, and preview simple fixes."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,6" />
                            <WrapPanel>
                                <Button Content="Build"
                                        Command="{Binding RunCodingBuildCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Tests"
                                        Command="{Binding RunCodingTestCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Last Failure"
                                        Command="{Binding RunCodingLastFailureCommand}" />
                                <Button Content="Suggest Fix"
                                        Command="{Binding RunCodingSuggestFixCommand}" />
                                <Button Content="Patch Preview"
                                        Command="{Binding RunCodingShowPatchPreviewCommand}" />
                                <Button Content="Apply Preview"
                                        Command="{Binding RunCodingApplyPreviewCommand}"
                                        BorderBrush="#8A6A18"
                                        Background="#2A2415" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Receipts"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Review the coding receipts that support a commit or handoff."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,6" />
                            <WrapPanel>
                                <Button Content="Coding Receipts"
                                        Command="{Binding RunCodingReceiptsCommand}" />
                                <Button Content="Timeline"
                                        Command="{Binding RunCodingTimelineCommand}" />
                                <Button Content="Commit Msg"
                                        Command="{Binding RunCodingCommitMessageCommand}" />
                                <Button Content="Release Notes"
                                        Command="{Binding RunCodingReleaseNotesCommand}" />
                                <Button Content="Rollback Plan"
                                        Command="{Binding RunCodingRollbackPlanCommand}" />
                                <Button Content="Open Receipt Folder"
                                        Command="{Binding OpenMaintenanceReceiptFolderCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Latest Programming Result"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding MaintenanceStatusText}"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="2"
                               Text="{Binding MaintenanceReceiptPath, StringFormat=Receipts: {0}}"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
