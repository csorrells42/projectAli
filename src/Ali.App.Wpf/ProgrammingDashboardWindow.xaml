<Window x:Class="Ali.App.Wpf.ProgrammingDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programming"
        Height="620"
        MinHeight="560"
        Width="980"
        MinWidth="860"
        Background="#0B0B0D"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202024" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#323236" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9DA4AE" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    Content="Close"
                    Click="CloseButtonClick"
                    MinWidth="82"
                    Margin="12,0,0,0" />
            <StackPanel>
                <TextBlock Text="Programming"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="Workspace review, validation, builds, tests, failure diagnosis, and safe patch previews."
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*" />
                <ColumnDefinition Width="1.08*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <UniformGrid Columns="1">
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Coding Cockpit"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <UniformGrid Columns="5" Margin="0,8,0,2">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Next" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                    <TextBlock Text="Action" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Risk" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                    <TextBlock Text="Guarded" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Validation" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                    <TextBlock Text="Queued" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Patch" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                    <TextBlock Text="Owner OK" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Commit" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                    <TextBlock Text="Checked" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Mini-Codex Readiness"
                                        Command="{Binding RunCodingReadinessReportCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Next Best Coding Action"
                                        Command="{Binding RunCodingNextBestActionCommand}" />
                                <Button Content="Validation Queue"
                                        Command="{Binding RunCodingValidationQueueCommand}" />
                                <Button Content="Patch Batch"
                                        Command="{Binding RunCodingPatchBatchCommand}" />
                                <Button Content="Symbol Diff Audit"
                                        Command="{Binding RunCodingSymbolDiffAuditCommand}" />
                                <Button Content="Generated File Guard"
                                        Command="{Binding RunCodingGeneratedFileGuardCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Build Feature"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Intent, tests, slices, and closeout before code changes."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,6" />
                            <WrapPanel>
                                <Button Content="Feature Builder"
                                        Command="{Binding RunCodingFeatureBuilderCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Build Feature Lane"
                                        Command="{Binding RunCodingBuildFeatureLaneCommand}" />
                                <Button Content="Work Context"
                                        Command="{Binding RunCodingFeatureWorkContextCommand}" />
                                <Button Content="Feature Intent"
                                        Command="{Binding RunCodingFeatureIntentCommand}" />
                                <Button Content="Contract"
                                        Command="{Binding RunCodingBehaviorContractCommand}" />
                                <Button Content="Behavior Tests"
                                        Command="{Binding RunCodingBehaviorTestsCommand}" />
                                <Button Content="Implementation Slices"
                                        Command="{Binding RunCodingImplementationSlicesCommand}" />
                                <Button Content="Patch Slices"
                                        Command="{Binding RunCodingPatchSlicesCommand}" />
                                <Button Content="Exact Patch"
                                        Command="{Binding RunCodingExactPatchCommand}" />
                                <Button Content="Patch Intelligence"
                                        Command="{Binding RunCodingPatchIntelligenceCommand}" />
                                <Button Content="Patch Loop"
                                        Command="{Binding RunCodingPatchLoopCommand}" />
                                <Button Content="Session Ledger"
                                        Command="{Binding RunCodingFeatureSessionLedgerCommand}" />
                                <Button Content="Execution Packet"
                                        Command="{Binding RunCodingFeatureExecutionPacketCommand}" />
                                <Button Content="Apply Gate"
                                        Command="{Binding RunCodingApplyGateCommand}" />
                                <Button Content="Validation Router"
                                        Command="{Binding RunCodingPostPatchValidationCommand}" />
                                <Button Content="Completion Receipt"
                                        Command="{Binding RunCodingFeatureCompletionReceiptCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Workspace"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Read-only checks before changing code."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,6" />
                            <WrapPanel>
                                <Button Content="Workspace"
                                        Command="{Binding RunCodingWorkspaceDiagnosticCommand}" />
                                <Button Content="Project Index"
                                        Command="{Binding RunCodingProjectIndexCommand}" />
                                <Button Content="Understand Repo"
                                        Command="{Binding RunCodingRepoUnderstandingCommand}" />
                                <Button Content="Context"
                                        Command="{Binding RunCodingContextPacketCommand}" />
                                <Button Content="Full Readiness"
                                        Command="{Binding RunCodingFullReadinessCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Mini-Codex"
                                        Command="{Binding RunCodingMiniCodexStatusCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Code Intelligence"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Roslyn-backed symbol, call, binding, and test-impact checks."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,6" />
                            <WrapPanel>
                                <Button Content="Symbols"
                                        Command="{Binding RunCodingSymbolIndexCommand}" />
                                <Button Content="Call Graph"
                                        Command="{Binding RunCodingCallGraphCommand}" />
                                <Button Content="Ownership"
                                        Command="{Binding RunCodingOwnershipMapCommand}" />
                                <Button Content="Bindings"
                                        Command="{Binding RunCodingBindingCheckCommand}" />
                                <Button Content="Impacted Tests"
                                        Command="{Binding RunCodingImpactedTestsCommand}" />
                                <Button Content="Test Target"
                                        Command="{Binding RunCodingTestTargetCommand}" />
                                <Button Content="Safe Edit"
                                        Command="{Binding RunCodingSafeEditWorkflowCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Execution Packet"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Prepare, approve, inspect, and track one self-scored coding packet."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,6" />
                            <WrapPanel>
                                <Button Content="Prepare"
                                        Command="{Binding RunCodingExecutionPacketCommand}" />
                                <Button Content="Approve"
                                        Command="{Binding RunCodingApprovePacketCommand}"
                                        BorderBrush="#8A6A18"
                                        Background="#2A2415" />
                                <Button Content="Show Packet"
                                        Command="{Binding RunCodingShowApprovedPacketCommand}" />
                                <Button Content="Progress"
                                        Command="{Binding RunCodingPacketProgressCommand}" />
                                <Button Content="Commands"
                                        Command="{Binding RunCodingPacketCommandsCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Build Loop"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Run confirmed validation, inspect failures, and preview simple fixes."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,6" />
                            <WrapPanel>
                                <Button Content="Review"
                                        Command="{Binding RunCodingReviewChangesCommand}" />
                                <Button Content="Build"
                                        Command="{Binding RunCodingBuildCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Tests"
                                        Command="{Binding RunCodingTestCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Last Failure"
                                        Command="{Binding RunCodingLastFailureCommand}" />
                                <Button Content="Suggest Fix"
                                        Command="{Binding RunCodingSuggestFixCommand}" />
                                <Button Content="Patch Preview"
                                        Command="{Binding RunCodingShowPatchPreviewCommand}" />
                                <Button Content="Apply Preview"
                                        Command="{Binding RunCodingApplyPreviewCommand}"
                                        BorderBrush="#8A6A18"
                                        Background="#2A2415" />
                                <Button Content="Safe Commit"
                                        Command="{Binding RunCodingSafeCommitCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Receipts"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Review the coding receipts that support a commit or handoff."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,6" />
                            <WrapPanel>
                                <Button Content="Coding Receipts"
                                        Command="{Binding RunCodingReceiptsCommand}" />
                                <Button Content="Timeline"
                                        Command="{Binding RunCodingTimelineCommand}" />
                                <Button Content="Commit Msg"
                                        Command="{Binding RunCodingCommitMessageCommand}" />
                                <Button Content="Release Notes"
                                        Command="{Binding RunCodingReleaseNotesCommand}" />
                                <Button Content="Rollback Plan"
                                        Command="{Binding RunCodingRollbackPlanCommand}" />
                                <Button Content="Open Receipt Folder"
                                        Command="{Binding OpenMaintenanceReceiptFolderCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Latest Programming Result"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding MaintenanceStatusText}"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="2"
                               Text="{Binding MaintenanceReceiptPath, StringFormat=Receipts: {0}}"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
