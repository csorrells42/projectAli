<Window x:Class="Ali.App.Wpf.ProgrammingDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programming"
        Height="620"
        MinHeight="520"
        Width="980"
        MinWidth="860"
        Background="#0B0B0D"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202024" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#323236" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9DA4AE" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,6,6,0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#101114" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,12,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="Close"
                    Click="CloseButtonClick"
                    MinWidth="82"
                    Margin="12,0,0,0" />
            <TextBlock Text="Programming"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="24"
                       FontWeight="SemiBold" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.94*" />
                <ColumnDefinition Width="1.06*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Project Target" Style="{StaticResource SectionHeading}" />
                            <TextBlock Text="{Binding CodingDashboardCurrentTargetText}"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="{Binding CodingDashboardCurrentTaskText}"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Current" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding CodingCurrentSolutionOrProjectPathText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Current .sln, .slnx, or .csproj" />
                                <Button Grid.Column="3"
                                        Content="Choose File"
                                        Command="{Binding BrowseCodingCurrentSolutionOrProjectCommand}"
                                        Margin="0"
                                        Padding="8,5" />
                                <Button Grid.Column="5"
                                        Content="Save Path"
                                        Command="{Binding SaveCodingPermissionsCommand}"
                                        Margin="0"
                                        Padding="8,5" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="New folder" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding CodingWorkspaceRootText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Folder for new projects" />
                                <Button Grid.Column="3"
                                        Content="Choose Folder"
                                        Command="{Binding BrowseCodingWorkspaceRootCommand}"
                                        Margin="0"
                                        Padding="8,5" />
                                <Button Grid.Column="5"
                                        Content="New Project"
                                        Command="{Binding CreateCodingProjectCommand}"
                                        Margin="0"
                                        Padding="8,5" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Coding Cockpit" Style="{StaticResource SectionHeading}" />
                            <UniformGrid Columns="5" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Next" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                    <TextBlock Text="Action" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Risk" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                    <TextBlock Text="Guarded" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Validation" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                    <TextBlock Text="Queued" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Patch" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                    <TextBlock Text="Owner OK" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Commit" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                    <TextBlock Text="Checked" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="Start Session"
                                        Command="{Binding StartCodingSessionCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Continue Task"
                                        Command="{Binding ContinueCodingCurrentTaskCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Current Task"
                                        Command="{Binding ShowCodingCurrentTaskCommand}" />
                                <Button Content="Next Action"
                                        Command="{Binding RunCodingNextBestActionCommand}" />
                                <Button Content="Mini-Codex"
                                        Command="{Binding RunCodingMiniCodexStatusCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Project" Style="{StaticResource SectionHeading}" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="Project Center"
                                        Command="{Binding RunCodingProjectControlCenterCommand}" />
                                <Button Content="Project Memory"
                                        Command="{Binding RunCodingProjectMemoryCommand}" />
                                <Button Content="Workspace"
                                        Command="{Binding RunCodingWorkspaceDiagnosticCommand}" />
                                <Button Content="Project Index"
                                        Command="{Binding RunCodingProjectIndexCommand}" />
                                <Button Content="Open Folder"
                                        Command="{Binding OpenCodingCurrentProjectFolderCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Build Loop" Style="{StaticResource SectionHeading}" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="Build Current"
                                        Command="{Binding RunCodingBuildCurrentCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Test Current"
                                        Command="{Binding RunCodingTestCurrentCommand}"
                                        BorderBrush="#1E6B49"
                                        Background="#152A22" />
                                <Button Content="Run Current"
                                        Command="{Binding RunCodingRunCurrentCommand}" />
                                <Button Content="Last Failure"
                                        Command="{Binding RunCodingLastFailureCommand}" />
                                <Button Content="Safe Commit"
                                        Command="{Binding RunCodingSafeCommitCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Patch And Handoff" Style="{StaticResource SectionHeading}" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="Exact Patch"
                                        Command="{Binding RunCodingExactPatchCommand}" />
                                <Button Content="Patch Preview"
                                        Command="{Binding RunCodingShowPatchPreviewCommand}" />
                                <Button Content="Apply Preview"
                                        Command="{Binding RunCodingApplyPreviewCommand}"
                                        BorderBrush="#8A6A18"
                                        Background="#2A2415" />
                                <Button Content="Validation Queue"
                                        Command="{Binding RunCodingValidationQueueCommand}" />
                                <Button Content="Receipts"
                                        Command="{Binding RunCodingReceiptsCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    VerticalAlignment="Top"
                    MaxHeight="410">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Latest Programming Result"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                        <TextBlock Text="{Binding MaintenanceStatusText}"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="2"
                               Text="{Binding MaintenanceReceiptPath, StringFormat=Receipts: {0}}"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
