<Window x:Class="Ali.App.Wpf.RuntimeOptimizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Runtime Recommendations"
        Height="620"
        Width="860"
        MinHeight="460"
        MinWidth="700"
        Background="#0B0B0D"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="InputBrush" Color="#0F0F11" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#323236" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00BEE6" />
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Runtime Recommendations"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="Estimated low, medium, and aggressive local model settings."
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1"
                Padding="12">
            <TextBox x:Name="ReportTextBox"
                     AcceptsReturn="True"
                     Background="{StaticResource InputBrush}"
                     BorderBrush="{StaticResource BorderBrushDark}"
                     CaretBrush="{StaticResource TextBrush}"
                     FontFamily="Consolas"
                     FontSize="13"
                     Foreground="{StaticResource TextBrush}"
                     HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    Orientation="Horizontal">
            <Button Content="Copy"
                    MinWidth="88"
                    Click="CopyButton_OnClick" />
            <Button Content="Close"
                    IsCancel="True"
                    MinWidth="88"
                    Click="CloseButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
