<Window x:Class="Ali.App.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ali Settings"
        Height="700"
        Width="960"
        MinHeight="620"
        MinWidth="840"
        Background="#0B0B0D"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202024" />
        <SolidColorBrush x:Key="InputBrush" Color="#0F0F11" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#323236" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9DA4AE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00BEE6" />

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#34343A" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#5A5A63" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#202024" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#17171A" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#303036" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter TargetName="TextBoxChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="#303036" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="ComboRoot"
                              SnapsToDevicePixels="True"
                              TextElement.Foreground="{TemplateBinding Foreground}">
                            <Border x:Name="ComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Margin="9,0,30,0"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                            <Path x:Name="DropDownArrow"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{StaticResource MutedTextBrush}"
                                  HorizontalAlignment="Right"
                                  IsHitTestVisible="False"
                                  Margin="0,0,10,0"
                                  Stretch="Fill"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="4" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1">
                                        <ScrollViewer CanContentScroll="True"
                                                      Padding="0">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#5A5A63" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="DropDownArrow" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter TargetName="ComboRoot" Property="TextElement.Foreground" Value="#8B929E" />
                                <Setter TargetName="ComboChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#303036" />
                                <Setter TargetName="DropDownArrow" Property="Fill" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#24323A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#1D3B45" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="TabChrome" Property="Background" Value="#24242A" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#202024" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter TargetName="TabChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#303036" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Local runtime, voice, and microphone controls." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Runtime">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBackgroundBrush}">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Runtime Settings"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding RuntimeDisplay}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,10" />
                            <TextBlock Text="{Binding ActiveRuntimeStatus}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="Endpoint" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RuntimeEndpointText, UpdateSourceTrigger=PropertyChanged}" />

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Installed model" Style="{StaticResource FieldLabel}" />
                                <Button DockPanel.Dock="Right"
                                        Content="Refresh"
                                        Command="{Binding RefreshRuntimeModelsCommand}"
                                        Padding="8,5"
                                        Margin="8,0,0,0" />
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding RuntimeModelChoices}"
                                      SelectedItem="{Binding SelectedRuntimeModelChoice}"
                                      Margin="0,2,0,8" />
                            <TextBlock Text="{Binding RuntimeSelectionStatusText}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Quantization" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding RuntimeQuantizationChoices}"
                                      SelectedItem="{Binding RuntimeQuantizationText}"
                                      Margin="0,2,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Context" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding RuntimeContextChoices}"
                                              SelectedItem="{Binding RuntimeContextText}"
                                              Margin="0,2,0,8" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Output" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding RuntimeOutputLimitChoices}"
                                              SelectedItem="{Binding RuntimeOutputLimitText}"
                                              Margin="0,2,0,8" />
                                </StackPanel>
                            </Grid>

                            <UniformGrid Columns="4" Margin="0,8,0,0">
                                <Button Content="Save" Command="{Binding SaveRuntimeSettingsCommand}" Margin="0,0,5,0" />
                                <Button Content="Check" Command="{Binding CheckRuntimeCommand}" Margin="5,0,5,0" />
                                <Button Content="Activate"
                                        Command="{Binding ActivateRuntimeCommand}"
                                        IsEnabled="{Binding CanActivateRuntime}"
                                        Margin="5,0,5,0" />
                                <Button Content="Stub" Command="{Binding RevertToStubCommand}" Margin="5,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Voice / Mic">
                <Grid Background="#05070A" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Mic"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VoiceInputDevices}"
                                      SelectedItem="{Binding SelectedVoiceInputDevice}"
                                      Height="30" />

                            <TextBlock Grid.Column="2"
                                       Text="Channel"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,8,0" />
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding VoiceInputChannelModes}"
                                      SelectedItem="{Binding SelectedVoiceInputChannelMode}"
                                      Height="30" />

                            <TextBlock Grid.Column="4"
                                       Text="Gain"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,8,0" />
                            <Slider Grid.Column="5"
                                    Minimum="1"
                                    Maximum="24"
                                    Value="{Binding SpectrumDisplayGain, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" />

                            <TextBlock Grid.Column="6"
                                       Text="{Binding SpectrumPeakText}"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,12,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Audio Confidence"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="14"
                                         Height="14"
                                         Fill="#42D77D"
                                         Stroke="{StaticResource MutedTextBrush}"
                                         StrokeThickness="1"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />
                                <TextBlock Text="DSP active"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Row="2"
                                    MinHeight="130"
                                    Background="#05070A"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    Margin="0,0,0,10">
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="720"
                                            Height="130"
                                            ClipToBounds="True"
                                            SnapsToDevicePixels="True">
                                        <Polyline Points="{Binding SpectrumLivePoints}"
                                                  Stroke="#00BEE6"
                                                  StrokeThickness="2.5"
                                                  StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <TextBlock Grid.Row="3"
                                       Text="Processed signal being monitored"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />
                            <StackPanel Grid.Row="4">
                                <TextBlock Text="{Binding VoiceInputMeterText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                                <TextBlock Text="{Binding VoiceDiagnosticsText}"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Ali voice"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding PiperVoiceChoices}"
                                      SelectedItem="{Binding SelectedPiperVoiceChoice}"
                                      Height="30" />
                            <Button Grid.Column="2"
                                    Content="Hear Sample"
                                    Command="{Binding PlayPiperSampleCommand}"
                                    MinWidth="112"
                                    Margin="12,0,12,0" />
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TtsStatus}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                                <TextBlock Text="{Binding VoiceSettingsStatusText}"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Corrections">
                <Grid Background="{StaticResource AppBackgroundBrush}" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Refresh"
                                        Command="{Binding RefreshCorrectionsCommand}"
                                        MinWidth="82"
                                        Margin="8,0,0,0" />
                                <Button Content="Reviewed"
                                        Command="{Binding MarkCorrectionReviewedCommand}"
                                        MinWidth="88"
                                        Margin="8,0,0,0" />
                                <Button Content="Unresolved"
                                        Command="{Binding MarkCorrectionUnresolvedCommand}"
                                        MinWidth="96"
                                        Margin="8,0,0,0" />
                                <Button Content="Export"
                                        Command="{Binding ExportSelectedCorrectionCommand}"
                                        MinWidth="78"
                                        Margin="8,0,0,0" />
                                <Button Content="Export All"
                                        Command="{Binding ExportAllCorrectionsCommand}"
                                        MinWidth="92"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding CorrectionReviewStatusText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox ItemsSource="{Binding CorrectionReviewItems}"
                                 SelectedItem="{Binding SelectedCorrectionReviewItem, Mode=TwoWay}"
                                 Background="{StaticResource PanelBrush}"
                                 BorderBrush="{StaticResource BorderBrushDark}"
                                 Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8"
                                            Margin="0,0,0,6"
                                            Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding DisplayStatus}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding CreatedAtText}"
                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                           FontSize="11" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding QuestionPreview}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding AnswerPreview}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Column="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedCorrectionReviewItem}">
                                    <TextBlock Text="{Binding Id}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ConversationText}"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10" />
                                    <TextBlock Text="{Binding RuntimeText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VoiceText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding AttachmentText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SafetyText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,14" />

                                    <TextBlock Text="Exact user question"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Question}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="90"
                                             Margin="0,6,0,12" />

                                    <TextBlock Text="Exact assistant answer"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Answer}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="160"
                                             Margin="0,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
