<Window x:Class="Ali.App.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AssistantSettingsWindowTitle}"
        Height="700"
        Width="960"
        MinHeight="620"
        MinWidth="840"
        Background="#0B0B0D"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202024" />
        <SolidColorBrush x:Key="InputBrush" Color="#0F0F11" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#323236" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9DA4AE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00BEE6" />

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#34343A" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#5A5A63" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#202024" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#17171A" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#303036" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter TargetName="TextBoxChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="#303036" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="ComboRoot"
                              SnapsToDevicePixels="True"
                              TextElement.Foreground="{TemplateBinding Foreground}">
                            <Border x:Name="ComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Margin="9,0,30,0"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                            <Path x:Name="DropDownArrow"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{StaticResource MutedTextBrush}"
                                  HorizontalAlignment="Right"
                                  IsHitTestVisible="False"
                                  Margin="0,0,10,0"
                                  Stretch="Fill"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="4" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1">
                                        <ScrollViewer CanContentScroll="True"
                                                      Padding="0">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#5A5A63" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="DropDownArrow" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter TargetName="ComboRoot" Property="TextElement.Foreground" Value="#8B929E" />
                                <Setter TargetName="ComboChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#303036" />
                                <Setter TargetName="DropDownArrow" Property="Fill" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#24323A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#1D3B45" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#4B5563" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Background="{TemplateBinding Background}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#6B7280" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#111114" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="ScrollRoot"
                              Background="{TemplateBinding Background}"
                              SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{TemplateBinding Foreground}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="14" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="ScrollRoot" Property="MinHeight" Value="14" />
                                <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#303036" />
                                <Setter Property="Background" Value="#0F0F11" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid ClipToBounds="False" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Margin="0,0,0,-1"
                                      Panel.ZIndex="1" />
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,1,0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="TabChrome" Property="Background" Value="#24242A" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#202024" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter TargetName="TabChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#303036" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Local runtime, voice, and microphone controls." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <TabControl x:Name="SettingsTabs"
                    Grid.Row="1"
                    Margin="0"
                    Padding="0"
                    ClipToBounds="False">
            <TabItem x:Name="RuntimeTab" Header="Runtime">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBackgroundBrush}">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,12,10,0">
                        <StackPanel>
                            <TextBlock Text="Runtime Settings"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding RuntimeDisplay}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,10" />
                            <TextBlock Text="{Binding ActiveRuntimeStatus}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,10" />

                            <Border Background="#201819"
                                    BorderBrush="#684044"
                                    BorderThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Advanced runtime settings"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="These settings can break local model startup, slow the assistant down, or make owner testing confusing if changed accidentally."
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,3,0,8" />
                                    <CheckBox x:Name="RuntimeAdvancedUnlockCheck"
                                              Content="I understand. Enable runtime settings."
                                              ToolTip="Check this only when intentionally changing local runtime settings." />
                                </StackPanel>
                            </Border>

                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=RuntimeAdvancedUnlockCheck}"
                                        Margin="0,0,4,0">
                                <TextBlock Text="Endpoint" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RuntimeEndpointText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,2" />
                                <Button Content="Refresh"
                                        Command="{Binding RefreshRuntimeModelsCommand}"
                                        Width="86"
                                        Padding="8,5"
                                        HorizontalAlignment="Right"
                                        Margin="0,4,0,2"
                                        ToolTip="Refresh installed model choices from the endpoint." />
                                <TextBlock Text="Local OpenAI-compatible URL. Leave this on localhost for owner testing."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Installed model" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding RuntimeModelChoices}"
                                          SelectedItem="{Binding SelectedRuntimeModelChoice}"
                                          Margin="0,2,0,4" />
                                <TextBlock Text="{Binding AssistantWillUseSelectedModelText}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding RuntimeSelectionStatusText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Quantization" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding RuntimeQuantizationChoices}"
                                          SelectedItem="{Binding RuntimeQuantizationText}"
                                          Margin="0,2,0,2" />
                                <TextBlock Text="Model packaging/performance profile. Usually leave this on the installed default."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Context" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding RuntimeContextChoices}"
                                                  SelectedItem="{Binding RuntimeContextText}"
                                                  Margin="0,2,0,2" />
                                        <TextBlock Text="Memory window; higher uses more RAM."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Output" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding RuntimeOutputLimitChoices}"
                                                  SelectedItem="{Binding RuntimeOutputLimitText}"
                                                  Margin="0,2,0,2" />
                                        <TextBlock Text="Max reply length in tokens."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding RuntimeTemperatureChoices}"
                                                  SelectedItem="{Binding RuntimeTemperatureText}"
                                                  Margin="0,2,0,2"
                                                  ToolTip="Lower is steadier. Use 0.0-1.0 for normal assistant testing." />
                                        <TextBlock Text="Lower is steadier; presets stay in range."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Top-p" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding RuntimeTopPChoices}"
                                                  SelectedItem="{Binding RuntimeTopPText}"
                                                  Margin="0,2,0,2"
                                                  ToolTip="Optional nucleus sampling value. Use model default unless tuning is needed." />
                                        <TextBlock Text="Sampling cutoff; default is usually best."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <CheckBox Content="Streaming responses"
                                                  IsChecked="{Binding RuntimeStreamingEnabled}"
                                                  Margin="0,0,0,2"
                                                  ToolTip="User selectable. Shows response text as it arrives." />
                                        <TextBlock Text="User selectable; shows response text as it arrives."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <CheckBox Content="Vision/image support"
                                                  IsChecked="{Binding RuntimeVisionEnabled}"
                                                  Margin="0,0,0,2"
                                                  ToolTip="User selectable. Enable only for image-capable models." />
                                        <TextBlock Text="User selectable; enable only for image-capable models."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Stop markers are controlled by the Ollama model tag or Modelfile."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,8,0,0" />

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0">
                                    <Button Content="Save"
                                            Command="{Binding SaveRuntimeSettingsCommand}"
                                            Width="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Check"
                                            Command="{Binding CheckRuntimeCommand}"
                                            Width="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Recommend"
                                            Command="{Binding RecommendRuntimeSettingsCommand}"
                                            Width="112"
                                            Margin="0,0,8,0"
                                            ToolTip="Estimate low, medium, and aggressive settings for the selected model and this computer." />
                                    <Button Content="Activate"
                                            Command="{Binding ActivateRuntimeCommand}"
                                            IsEnabled="{Binding CanActivateRuntime}"
                                            Width="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Stub"
                                            Command="{Binding RevertToStubCommand}"
                                            Width="86"
                                            Margin="0" />
                                </StackPanel>

                                <Border BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        Padding="10"
                                        Margin="0,12,0,0">
                                    <TextBlock Text="{Binding RuntimeHealthResult}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Voice / Mic">
                <Grid Background="#05070A" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Mic"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VoiceInputDevices}"
                                      SelectedItem="{Binding SelectedVoiceInputDevice}"
                                      Height="30" />

                            <TextBlock Grid.Column="2"
                                       Text="Channel"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,8,0" />
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding VoiceInputChannelModes}"
                                      SelectedItem="{Binding SelectedVoiceInputChannelMode}"
                                      Height="30" />

                            <TextBlock Grid.Column="4"
                                       Text="Gain"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,8,0" />
                            <Slider Grid.Column="5"
                                    Minimum="1"
                                    Maximum="24"
                                    Value="{Binding SpectrumDisplayGain, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" />

                            <TextBlock Grid.Column="6"
                                       Text="{Binding SpectrumPeakText}"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />

                            <TextBlock Grid.Column="7"
                                       Text="{Binding PushToTalkKeyLabel}"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,8,0" />
                            <Button Grid.Column="8"
                                    Content="{Binding AssignPushToTalkKeyButtonText}"
                                    Command="{Binding BeginAssignPushToTalkKeyCommand}"
                                    MinWidth="104"
                                    ToolTip="Click, then press the key you want to use for Push to Talk." />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,12,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Audio Confidence"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="14"
                                         Height="14"
                                         Fill="#42D77D"
                                         Stroke="{StaticResource MutedTextBrush}"
                                         StrokeThickness="1"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />
                                <TextBlock Text="DSP active"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Row="2"
                                    MinHeight="130"
                                    Background="#05070A"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    Margin="0,0,0,10">
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="720"
                                            Height="130"
                                            ClipToBounds="True"
                                            SnapsToDevicePixels="True">
                                        <Polyline Points="{Binding SpectrumLivePoints}"
                                                  Stroke="#00BEE6"
                                                  StrokeThickness="2.5"
                                                  StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <TextBlock Grid.Row="3"
                                       Text="Processed signal being monitored"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />
                            <StackPanel Grid.Row="4">
                                <TextBlock Text="{Binding VoiceInputMeterText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                                <TextBlock Text="{Binding VoiceDiagnosticsText}"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding AssistantVoiceLabel}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TextToSpeechEngineChoices}"
                                      SelectedItem="{Binding TextToSpeechEngineText}"
                                      Height="30" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding TextToSpeechVoiceChoices}"
                                      SelectedItem="{Binding SelectedTextToSpeechVoiceChoice}"
                                      Height="30"
                                      Margin="8,0,0,0" />
                            <Button Grid.Column="3"
                                    Content="Hear Sample"
                                    Command="{Binding PlayVoiceSampleCommand}"
                                    MinWidth="112"
                                    Margin="12,0,12,0" />
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TtsStatus}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                                <TextBlock Text="{Binding VoiceSettingsStatusText}"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Corrections">
                <Grid Background="{StaticResource AppBackgroundBrush}" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Refresh"
                                        Command="{Binding RefreshCorrectionsCommand}"
                                        MinWidth="82"
                                        Margin="8,0,0,0" />
                                <Button Content="Reviewed"
                                        Command="{Binding MarkCorrectionReviewedCommand}"
                                        MinWidth="88"
                                        Margin="8,0,0,0" />
                                <Button Content="Unresolved"
                                        Command="{Binding MarkCorrectionUnresolvedCommand}"
                                        MinWidth="96"
                                        Margin="8,0,0,0" />
                                <Button Content="Export"
                                        Command="{Binding ExportSelectedCorrectionCommand}"
                                        MinWidth="78"
                                        Margin="8,0,0,0" />
                                <Button Content="Export All"
                                        Command="{Binding ExportAllCorrectionsCommand}"
                                        MinWidth="92"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding CorrectionReviewStatusText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox ItemsSource="{Binding CorrectionReviewItems}"
                                 SelectedItem="{Binding SelectedCorrectionReviewItem, Mode=TwoWay}"
                                 Background="{StaticResource PanelBrush}"
                                 BorderBrush="{StaticResource BorderBrushDark}"
                                 Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8"
                                            Margin="0,0,0,6"
                                            Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding DisplayStatus}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding CreatedAtText}"
                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                           FontSize="11" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding QuestionPreview}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding AnswerPreview}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Column="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedCorrectionReviewItem}">
                                    <TextBlock Text="{Binding Id}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ConversationText}"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10" />
                                    <TextBlock Text="{Binding RuntimeText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VoiceText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding AttachmentText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SafetyText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,14" />

                                    <TextBlock Text="Exact user question"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Question, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="90"
                                             Margin="0,6,0,12" />

                                    <TextBlock Text="Exact assistant answer"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Answer, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="160"
                                             Margin="0,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Memory / Reminders">
                <Grid Background="{StaticResource AppBackgroundBrush}" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Refresh"
                                    Command="{Binding RefreshMemoryRemindersCommand}"
                                    MinWidth="82"
                                    Margin="8,0,0,0" />
                            <TextBlock Text="{Binding MemoryReminderStatusText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Memory"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,0,0,10" />
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding MemoryEntries}"
                                         SelectedItem="{Binding SelectedMemoryEntry, Mode=TwoWay}"
                                         Background="{StaticResource InputBrush}"
                                         BorderBrush="{StaticResource BorderBrushDark}"
                                         Foreground="{StaticResource TextBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8"
                                                    Margin="0,0,0,6"
                                                    Background="{StaticResource PanelAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrushDark}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding UpdatedAtText}"
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               FontSize="11"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding SensitivityText}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Delete"
                                            Command="{Binding DeleteSelectedMemoryCommand}"
                                            MinWidth="82"
                                            Margin="0,0,8,0" />
                                    <Button Content="Clear Memories"
                                            Command="{Binding ClearMemoriesCommand}"
                                            MinWidth="118"
                                            BorderBrush="#7F1D1D"
                                            Background="#2A1517" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Local Reminders"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,0,0,10" />
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding ReminderEntries}"
                                         SelectedItem="{Binding SelectedReminderEntry, Mode=TwoWay}"
                                         Background="{StaticResource InputBrush}"
                                         BorderBrush="{StaticResource BorderBrushDark}"
                                         Foreground="{StaticResource TextBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8"
                                                    Margin="0,0,0,6"
                                                    Background="{StaticResource PanelAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrushDark}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding StatusText}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="11" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding DueAtText}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="12"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Complete"
                                            Command="{Binding CompleteSelectedReminderCommand}"
                                            MinWidth="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Cancel"
                                            Command="{Binding CancelSelectedReminderCommand}"
                                            MinWidth="76"
                                            Margin="0,0,8,0" />
                                    <Button Content="Clear Reminders"
                                            Command="{Binding ClearRemindersCommand}"
                                            MinWidth="126"
                                            BorderBrush="#7F1D1D"
                                            Background="#2A1517" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Maintenance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBackgroundBrush}">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,12,10,0">
                        <StackPanel>
                            <TextBlock Text="Computer Maintenance"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Run a read-only health check for Ali's install, local computer assistant lanes, PDF tools, Visual Studio bridge, source catalog, and recent receipts."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,12" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,14">
                                <Button Content="Run Health Check"
                                        Command="{Binding RunComputerHealthCheckCommand}"
                                        MinWidth="148"
                                        Margin="0,0,10,0" />
                            </StackPanel>

                            <Border Height="1"
                                    Background="{StaticResource BorderBrushDark}"
                                    Margin="0,0,0,14" />

                            <TextBlock Text="Backup &amp; Restore"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Create a zip backup of Ali's user data, or restore one after reinstalling. Ollama models are not included or changed."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,12" />

                            <Border Background="#14191C"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Included"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Conversations, memories, reminders, assistant profile/name, app settings, sources/topics, local library settings and index metadata, voice settings, runtime/model selection settings, receipts, and generated documents."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Temporary session audio and temporary screenshots are skipped."
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                <Button Content="Create Backup"
                                        Command="{Binding BackupUserDataCommand}"
                                        MinWidth="130"
                                        Margin="0,0,10,0" />
                                <Button Content="Restore Backup"
                                        Command="{Binding RestoreUserDataCommand}"
                                        MinWidth="130"
                                        BorderBrush="#7F1D1D"
                                        Background="#2A1517" />
                            </StackPanel>

                            <Border BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    Padding="10">
                                <TextBlock Text="{Binding MaintenanceStatusText}"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Coding / Permissions">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBackgroundBrush}">
                    <StackPanel Margin="0,12,10,0">
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Coding Workspace"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding AssistantCodingWorkspaceDescription}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,12" />

                                <TextBlock Text="Workspace root" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CodingWorkspaceRootText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0" />
                                    <Button Grid.Column="2"
                                            Content="Choose Folder"
                                            Command="{Binding BrowseCodingWorkspaceRootCommand}"
                                            Margin="0"
                                            Padding="8,5" />
                                </Grid>
                                <TextBlock Text="Default: C:\Users\&lt;you&gt;\Documents\Programming Projects"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="PDF workspace folder" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CodingPdfWorkspaceRootText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0" />
                                    <Button Grid.Column="2"
                                            Content="Choose Folder"
                                            Command="{Binding BrowseCodingPdfWorkspaceRootCommand}"
                                            Margin="0"
                                            Padding="8,5" />
                                </Grid>
                                <TextBlock Text="{Binding AssistantPdfWorkspaceDescription}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="Notepad++ executable or install folder" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CodingNotepadPlusPlusPathText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0" />
                                    <Button Grid.Column="2"
                                            Content="Choose Exe"
                                            Command="{Binding BrowseNotepadPlusPlusPathCommand}"
                                            Margin="0"
                                            Padding="8,5" />
                                </Grid>
                                <TextBlock Text="Leave blank to auto-detect. You may paste notepad++.exe or the Notepad++ install folder."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="Visual Studio executable or install folder" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CodingVisualStudioPathText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0" />
                                    <Button Grid.Column="2"
                                            Content="Choose Exe"
                                            Command="{Binding BrowseVisualStudioPathCommand}"
                                            Margin="0"
                                            Padding="8,5" />
                                </Grid>
                                <TextBlock Text="Leave blank to auto-detect with vswhere and normal install paths. You may paste devenv.exe, Common7\IDE, or the Visual Studio install root."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="Permission Controls"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,4,0,4" />
                                <TextBlock Text="{Binding AssistantCodingGuardrailsDescription}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,8" />
                                <Grid Margin="0,2,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Workspace read/open/search"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="0"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingWorkspaceAccessModeChoices}"
                                              SelectedItem="{Binding CodingWorkspaceAccessMode}"
                                              IsEnabled="False"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="2"
                                               Text="Allowed inside the approved coding folder."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="1"
                                               Text="Explicit outside file open/read"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingExplicitOutsideFileOpenModeChoices}"
                                              SelectedItem="{Binding CodingExplicitOutsideFileOpenMode, Mode=TwoWay}"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="2"
                                               Text="Allows opening a full file path you directly provide. It does not allow outside edits or broad searches."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="2"
                                               Text="Search outside workspace"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="2"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingSearchOutsideWorkspaceModeChoices}"
                                              SelectedItem="{Binding CodingSearchOutsideWorkspaceMode, Mode=TwoWay}"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="2"
                                               Text="Future file search behavior outside the approved folder."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="3"
                                               Text="Edit/write inside workspace"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="3"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingEditInsideWorkspaceModeChoices}"
                                              SelectedItem="{Binding CodingEditInsideWorkspaceMode, Mode=TwoWay}"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="2"
                                               Text="Future code edit behavior inside the approved folder."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="4"
                                               Text="Build/test/run inside workspace"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="4"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingBuildTestRunInsideWorkspaceModeChoices}"
                                              SelectedItem="{Binding CodingBuildTestRunInsideWorkspaceMode, Mode=TwoWay}"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="4"
                                               Grid.Column="2"
                                               Text="Future compile, test, and local command behavior inside the approved folder."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="5"
                                               Text="Delete/move/overwrite"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="5"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingDestructiveActionModeChoices}"
                                              SelectedItem="{Binding CodingDestructiveActionMode, Mode=TwoWay}"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="5"
                                               Grid.Column="2"
                                               Text="{Binding AssistantExtraConfirmationDescription}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="6"
                                               Text="Edit/run outside workspace"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="6"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingOutsideEditRunModeChoices}"
                                              SelectedItem="{Binding CodingOutsideEditRunMode, Mode=TwoWay}"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="6"
                                               Grid.Column="2"
                                               Text="Default is blocked. If enabled later, outside-workspace edit/run actions still require explicit owner confirmation."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="7"
                                               Text="System folders and admin actions"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,0" />
                                    <ComboBox Grid.Row="7"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingSystemAdminActionModeChoices}"
                                              SelectedItem="{Binding CodingSystemAdminActionMode, Mode=TwoWay}"
                                              Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="7"
                                               Grid.Column="2"
                                               Text="Default is blocked. Registry, services, drivers, and security settings stay outside the normal coding flow unless a future guarded lane supports them."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,0" />
                                </Grid>

                                <TextBlock Text="Git Controls"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,4,0,4" />
                                <TextBlock Text="Git is limited to repositories inside the approved workspace. Read-only inspection is separate from staging, committing, merging, and network operations."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,8" />
                                <Grid Margin="0,2,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Status, diff, and log"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="0"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingGitReadModeChoices}"
                                              SelectedItem="{Binding CodingGitReadMode, Mode=TwoWay}"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="2"
                                               Text="Read-only repository inspection inside the approved workspace."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="1"
                                               Text="Stage and commit"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingGitWriteModeChoices}"
                                              SelectedItem="{Binding CodingGitWriteMode, Mode=TwoWay}"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="2"
                                               Text="Git add and commit require confirmation and are blocked when disabled."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="2"
                                               Text="Merge"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="2"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingGitMergeModeChoices}"
                                              SelectedItem="{Binding CodingGitMergeMode, Mode=TwoWay}"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="2"
                                               Text="Merge requires extra confirmation because conflicts can change many files."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="3"
                                               Text="Pull and push"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,0" />
                                    <ComboBox Grid.Row="3"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingGitNetworkModeChoices}"
                                              SelectedItem="{Binding CodingGitNetworkMode, Mode=TwoWay}"
                                              Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="2"
                                               Text="Default is blocked. If enabled, network Git actions still require confirmation."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,0" />
                                </Grid>

                                <TextBlock Text="PDF Controls"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,4,0,4" />
                                <TextBlock Text="PDF reads are separate from PDF creation and assembly. Combine/split/modify creates derived files in the PDF workspace and requires confirmation by default."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,8" />
                                <Grid Margin="0,2,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Inspect and extract text"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="0"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingPdfReadModeChoices}"
                                              SelectedItem="{Binding CodingPdfReadMode, Mode=TwoWay}"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="2"
                                               Text="Read-only PDF inspection, text extraction, and summaries."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="1"
                                               Text="Create and export"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8" />
                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingPdfCreateModeChoices}"
                                              SelectedItem="{Binding CodingPdfCreateMode, Mode=TwoWay}"
                                              Margin="0,0,12,8" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="2"
                                               Text="Creates new PDFs and report PDFs in the selected PDF workspace."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,8" />

                                    <TextBlock Grid.Row="2"
                                               Text="Combine, split, and modify"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,0" />
                                    <ComboBox Grid.Row="2"
                                              Grid.Column="1"
                                              ItemsSource="{Binding CodingPdfModifyModeChoices}"
                                              SelectedItem="{Binding CodingPdfModifyMode, Mode=TwoWay}"
                                              Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="2"
                                               Text="Requires confirmation by default and writes derived files instead of changing originals."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,0" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Reset"
                                            Command="{Binding ResetCodingPermissionsCommand}"
                                            Width="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Save"
                                            Command="{Binding SaveCodingPermissionsCommand}"
                                            Width="86"
                                            Margin="0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Status"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding CodingPermissionsStatusText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{Binding CodingToolSettingsPath}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
