<Window x:Class="Ali.App.Wpf.VoiceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ali Voice Settings"
        Height="640"
        Width="860"
        MinHeight="560"
        MinWidth="760"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Voice Settings" FontSize="24" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="{Binding VoiceStatus}" Foreground="#4B5563" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Microphone">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Input device" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding VoiceInputDevices}"
                                          SelectedItem="{Binding SelectedVoiceInputDevice}"
                                          MinHeight="32" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Input channel" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding VoiceInputChannelModes}"
                                          SelectedItem="{Binding SelectedVoiceInputChannelMode}"
                                          MinHeight="32" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Input preset" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding VoiceInputPresets}"
                                          SelectedItem="{Binding SelectedVoiceInputPreset}"
                                          MinHeight="32" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Output device" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding VoiceOutputDevices}"
                                          SelectedItem="{Binding SelectedVoiceOutputDevice}"
                                          MinHeight="32" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Spectrum gain" Style="{StaticResource FieldLabel}" />
                                <Slider Minimum="1"
                                        Maximum="18"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="False"
                                        Value="{Binding SpectrumDisplayGain, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#07121E"
                                BorderBrush="#182C3E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding SpectrumPeakText}"
                                               Foreground="#C8E6F0"
                                               FontSize="12" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding VoiceInputMeterText}"
                                               Foreground="#C8E6F0"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </DockPanel>

                                <Viewbox Grid.Row="1" Stretch="Fill">
                                    <Canvas Width="720" Height="240" ClipToBounds="True">
                                        <Line X1="0" Y1="60" X2="720" Y2="60" Stroke="#173044" StrokeThickness="1" />
                                        <Line X1="0" Y1="120" X2="720" Y2="120" Stroke="#173044" StrokeThickness="1" />
                                        <Line X1="0" Y1="180" X2="720" Y2="180" Stroke="#173044" StrokeThickness="1" />
                                        <Line X1="120" Y1="0" X2="120" Y2="240" Stroke="#102537" StrokeThickness="1" />
                                        <Line X1="240" Y1="0" X2="240" Y2="240" Stroke="#102537" StrokeThickness="1" />
                                        <Line X1="360" Y1="0" X2="360" Y2="240" Stroke="#102537" StrokeThickness="1" />
                                        <Line X1="480" Y1="0" X2="480" Y2="240" Stroke="#102537" StrokeThickness="1" />
                                        <Line X1="600" Y1="0" X2="600" Y2="240" Stroke="#102537" StrokeThickness="1" />
                                        <Polyline Points="{Binding SpectrumAveragePoints}"
                                                  Stroke="#D7B220"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round" />
                                        <Polyline Points="{Binding SpectrumLivePoints}"
                                                  Stroke="#00BEE6"
                                                  StrokeThickness="2.5"
                                                  StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>

                                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Height="12"
                                                 Value="{Binding VoiceInputLevelPercent}" />
                                    <TextBlock Text="{Binding VoiceDiagnosticsText}"
                                               Foreground="#88AFC4"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Speech Tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="White" BorderBrush="#D6DAE0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Whisper" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Executable" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding WhisperExecutableText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding WhisperModelText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Arguments" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WhisperArgumentsText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding SttStatus}" Foreground="#4B5563" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="White" BorderBrush="#D6DAE0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Piper" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Executable" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding PiperExecutableText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding PiperModelText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Voice ID" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding PiperVoiceText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Arguments" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding PiperArgumentsText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <DockPanel Grid.Row="2" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TtsStatus}" Foreground="#4B5563" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock Text="{Binding VoiceSettingsStatusText}" Foreground="#4B5563" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Apply"
                                    Command="{Binding ApplyVoiceToolSettingsCommand}"
                                    MinWidth="120"
                                    Margin="12,0,0,0" />
                        </DockPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
