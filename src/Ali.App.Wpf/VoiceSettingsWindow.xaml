<Window x:Class="Ali.App.Wpf.VoiceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ali Voice Settings"
        Height="640"
        Width="860"
        MinHeight="560"
        MinWidth="760"
        Background="#0B0B0D"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="InputBrush" Color="#0F0F11" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18" Background="#0B0B0D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Voice Settings" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding VoiceStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Background="#05070A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="#18181B"
                    BorderBrush="#323236"
                    BorderThickness="1"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Mic"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding VoiceInputDevices}"
                              SelectedItem="{Binding SelectedVoiceInputDevice}"
                              Height="30" />

                    <TextBlock Grid.Column="2"
                               Text="Channel"
                               Foreground="#D0D5DD"
                               VerticalAlignment="Center"
                               Margin="14,0,8,0" />
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding VoiceInputChannelModes}"
                              SelectedItem="{Binding SelectedVoiceInputChannelMode}"
                              Height="30" />

                    <TextBlock Grid.Column="4"
                               Text="Gain"
                               Foreground="#D0D5DD"
                               VerticalAlignment="Center"
                               Margin="14,0,8,0" />
                    <Slider Grid.Column="5"
                            Minimum="1"
                            Maximum="24"
                            Value="{Binding SpectrumDisplayGain, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center" />

                    <TextBlock Grid.Column="6"
                               Text="{Binding SpectrumPeakText}"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="#18181B"
                    BorderBrush="#323236"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,12,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Audio Confidence"
                               Foreground="#F8FAFC"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="14"
                                 Height="14"
                                 Fill="#42D77D"
                                 Stroke="#D0D5DD"
                                 StrokeThickness="1"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="DSP active"
                                   Foreground="#D0D5DD"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            MinHeight="130"
                            Background="#05070A"
                            BorderBrush="#323236"
                            BorderThickness="1"
                            Margin="0,0,0,10">
                        <Viewbox Stretch="Fill">
                            <Canvas Width="720"
                                    Height="130"
                                    ClipToBounds="True"
                                    SnapsToDevicePixels="True">
                                <Polyline Points="{Binding SpectrumLivePoints}"
                                          Stroke="#00BEE6"
                                          StrokeThickness="2.5"
                                          StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <TextBlock Grid.Row="3"
                               Text="Processed signal being monitored"
                               Foreground="#D0D5DD"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{Binding VoiceInputMeterText}"
                                   Foreground="#D0D5DD"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                        <TextBlock Text="{Binding VoiceDiagnosticsText}"
                                   Foreground="#9DA4AE"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#18181B"
                    BorderBrush="#323236"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Ali voice"
                               Foreground="#F8FAFC"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding PiperVoiceChoices}"
                              SelectedItem="{Binding SelectedPiperVoiceChoice}"
                              Height="30" />
                    <Button Grid.Column="2"
                            Content="Hear Sample"
                            Command="{Binding PlayPiperSampleCommand}"
                            MinWidth="112"
                            Margin="12,0,12,0" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TtsStatus}"
                                   Foreground="#D0D5DD"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                        <TextBlock Text="{Binding VoiceSettingsStatusText}"
                                   Foreground="#9DA4AE"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
