<Window x:Class="Ali.App.Wpf.VoiceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ali Voice Settings"
        Height="640"
        Width="860"
        MinHeight="560"
        MinWidth="760"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Voice Settings" FontSize="24" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="{Binding VoiceStatus}" Foreground="#4B5563" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Background="#05070A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="#101821"
                    BorderBrush="#26323D"
                    BorderThickness="1"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Mic"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding VoiceInputDevices}"
                              SelectedItem="{Binding SelectedVoiceInputDevice}"
                              Height="30" />

                    <TextBlock Grid.Column="2"
                               Text="Channel"
                               Foreground="#B8C7D9"
                               VerticalAlignment="Center"
                               Margin="14,0,8,0" />
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding VoiceInputChannelModes}"
                              SelectedItem="{Binding SelectedVoiceInputChannelMode}"
                              Height="30" />

                    <TextBlock Grid.Column="4"
                               Text="Gain"
                               Foreground="#B8C7D9"
                               VerticalAlignment="Center"
                               Margin="14,0,8,0" />
                    <Slider Grid.Column="5"
                            Minimum="1"
                            Maximum="24"
                            Value="{Binding SpectrumDisplayGain, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center" />

                    <TextBlock Grid.Column="6"
                               Text="{Binding SpectrumPeakText}"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="#101821"
                    BorderBrush="#334F5D6B"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,12,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Audio Confidence"
                               Foreground="#F8FAFC"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="14"
                                 Height="14"
                                 Fill="#42D77D"
                                 Stroke="#B8C7D9"
                                 StrokeThickness="1"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="DSP active"
                                   Foreground="#B8C7D9"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            MinHeight="130"
                            Background="#05070A"
                            BorderBrush="#334F5D6B"
                            BorderThickness="1"
                            Margin="0,0,0,10">
                        <Viewbox Stretch="Fill">
                            <Canvas Width="720"
                                    Height="130"
                                    ClipToBounds="True"
                                    SnapsToDevicePixels="True">
                                <Polyline Points="{Binding SpectrumLivePoints}"
                                          Stroke="#00BEE6"
                                          StrokeThickness="2.5"
                                          StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <TextBlock Grid.Row="3"
                               Text="Processed signal being monitored"
                               Foreground="#B8C7D9"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{Binding VoiceInputMeterText}"
                                   Foreground="#B8C7D9"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                        <TextBlock Text="{Binding VoiceDiagnosticsText}"
                                   Foreground="#88AFC4"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#101821"
                    BorderBrush="#334F5D6B"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Ali voice"
                               Foreground="#F8FAFC"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding PiperVoiceChoices}"
                              SelectedItem="{Binding SelectedPiperVoiceChoice}"
                              Height="30" />
                    <Button Grid.Column="2"
                            Content="Hear Sample"
                            Command="{Binding PlayPiperSampleCommand}"
                            MinWidth="112"
                            Margin="12,0,12,0" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TtsStatus}"
                                   Foreground="#B8C7D9"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                        <TextBlock Text="{Binding VoiceSettingsStatusText}"
                                   Foreground="#88AFC4"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Expander Grid.Row="3"
                      Header="Advanced local tool paths"
                      Foreground="#B8C7D9"
                      Background="#101821"
                      BorderBrush="#334F5D6B">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding SttStatus}"
                               Foreground="#B8C7D9"
                               TextWrapping="Wrap"
                               FontSize="12" />

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Whisper executable" Foreground="#B8C7D9" FontSize="12" />
                            <TextBox Text="{Binding WhisperExecutableText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Piper executable" Foreground="#B8C7D9" FontSize="12" />
                            <TextBox Text="{Binding PiperExecutableText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Whisper model" Foreground="#B8C7D9" FontSize="12" />
                            <TextBox Text="{Binding WhisperModelText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Piper model" Foreground="#B8C7D9" FontSize="12" />
                            <TextBox Text="{Binding PiperModelText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding LastSttDebugText}"
                                   Foreground="#88AFC4"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                        <Button DockPanel.Dock="Right"
                                Content="Apply Advanced"
                                Command="{Binding ApplyVoiceToolSettingsCommand}"
                                MinWidth="130"
                                Margin="12,0,0,0" />
                    </DockPanel>
                </Grid>
            </Expander>
        </Grid>
    </Grid>
</Window>
