<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Ali</AssemblyName>
    <RootNamespace>Ali</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Agent Framework's file-access API is preview in 1.15.0; usage is isolated behind Modules/WorkstationFiles. -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ali.Framework.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="depricated\**\*.cs" />
    <EmbeddedResource Remove="depricated\**\*" />
    <None Remove="depricated\**\*" />
    <Page Remove="depricated\**\*.xaml" />
    <Resource Remove="depricated\**\*" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Modules\Voice\Tools\local_kitten_tts.py" />
    <None Remove="Modules\Voice\Tools\local_whisper_stt.py" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.15.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="SmartReader" Version="0.11.1" />
    <PackageReference Include="ReverseMarkdown" Version="6.1.0" />
    <PackageReference Include="Meziantou.Framework.HtmlSanitizer" Version="3.0.0" />
    <PackageReference Include="Qdrant.Client" Version="1.18.1" />
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260602" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\external\modules\ModuleContracts\ModuleContracts.csproj" />
    <ProjectReference Include="..\external\modules\CameraModule\CameraModule.csproj" />
    <ProjectReference Include="..\external\modules\MediaPipeModule\MediaPipeModule.csproj" />
    <ProjectReference Include="..\external\modules\IdentityModule\IdentityModule.csproj" />
    <ProjectReference Include="..\external\modules\IdentityEnrollmentGuidanceModule\IdentityEnrollmentGuidanceModule.csproj" />
    <ProjectReference Include="..\external\modules\AttentionModule\AttentionModule.csproj" />
    <ProjectReference Include="..\external\modules\MicrophoneModule\MicrophoneModule.csproj" />
    <ProjectReference Include="..\external\modules\VoiceActivityModule\VoiceActivityModule.csproj" />
    <ProjectReference Include="..\external\modules\SpeakerRecognitionModule\SpeakerRecognitionModule.csproj" />
    <ProjectReference Include="..\external\modules\WakeWordModule\WakeWordModule.csproj" />
    <ProjectReference Include="..\external\modules\AliSecurityModule\AliSecurityModule.csproj" />
    <ProjectReference Include="..\external\modules\SpeechToTextModule\SpeechToTextModule.csproj" />
    <ProjectReference Include="..\external\modules\ParakeetSpeechToTextModule\ParakeetSpeechToTextModule.csproj" />
    <ProjectReference Include="..\external\modules\InteractionConfidenceModule\InteractionConfidenceModule.csproj" />
    <ProjectReference Include="..\external\modules\TargetSelectionModule\TargetSelectionModule.csproj" />
    <ProjectReference Include="..\external\modules\ViewportModule\ViewportModule.csproj" />
    <ProjectReference Include="..\external\modules\OverlayModule\OverlayModule.csproj" />
  </ItemGroup>
</Project>
