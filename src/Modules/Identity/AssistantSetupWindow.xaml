<Window x:Class="Ali.Modules.Identity.AssistantSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant Setup"
        Height="300"
        Width="460"
        MinHeight="280"
        MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0B0D"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="InputBrush" Color="#0F0F11" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#46464D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00BEE6" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Name the assistant"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Text="Type the assistant name, not your name. Leave this as Ali unless you intentionally want to rename the assistant."
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,18" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Assistant name"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox x:Name="AssistantNameBox"
                     Text="Ali"
                     MaxLength="48" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Continue"
                    Click="Continue_Click"
                    BorderBrush="{StaticResource AccentBrush}" />
        </StackPanel>
    </Grid>
</Window>
