<Window x:Class="Ali.Modules.Interaction.IdentityReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identity Review"
        Width="1240"
        Height="780"
        MinWidth="820"
        MinHeight="560"
        Background="#080d12"
        Foreground="#f5f8fb"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#f5f8fb" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#142130" />
      <Setter Property="Foreground" Value="#f5f8fb" />
      <Setter Property="BorderBrush" Value="#37506a" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0f1720" />
      <Setter Property="Foreground" Value="#f5f8fb" />
      <Setter Property="CaretBrush" Value="#f5f8fb" />
      <Setter Property="BorderBrush" Value="#37506a" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#0f1720" />
      <Setter Property="Foreground" Value="#f5f8fb" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder"
                        Property="Background"
                        Value="#20364a" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder"
                        Property="Background"
                        Value="#1c4b35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#0f1720" />
      <Setter Property="Foreground" Value="#f5f8fb" />
      <Setter Property="BorderBrush" Value="#37506a" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                  <ToggleButton Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Mode=TwoWay}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                          <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                Fill="#b9d7ef"
                                Width="8"
                                Height="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,11,0" />
                        </Border>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <ContentPresenter Margin="9,0,36,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                </Grid>
              </Border>
              <Popup Name="PART_Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Fade">
                <Border Background="#0f1720"
                        BorderBrush="#37506a"
                        BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="240">
                  <ScrollViewer CanContentScroll="True"
                                SnapsToDevicePixels="True">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ComboBorder"
                        Property="BorderBrush"
                        Value="#68b8ee" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ComboBorder"
                        Property="Background"
                        Value="#0b1118" />
                <Setter Property="Foreground" Value="#71869a" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Identity Review"
                 FontSize="24"
                 FontWeight="Bold" />
      <TextBlock Margin="0,4,0,14"
                 Foreground="#b9d7ef"
                 Text="Only explicitly enrolled users are identified. Passive camera viewing never creates a person record." />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="520" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Background="#101820"
              BorderBrush="#243545"
              BorderThickness="1"
              CornerRadius="5"
              Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Live enrollment camera"
                     FontWeight="SemiBold"
                     Margin="2,0,0,8" />
          <Border Grid.Row="1"
                  Background="#020609"
                  BorderBrush="#37506a"
                  BorderThickness="1">
            <Grid Name="EnrollmentViewportHost">
              <TextBlock Name="NoLiveCameraText"
                         Text="Turn the camera on to enroll a user."
                         Foreground="#8ea8bc"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <TextBlock Name="EnrollmentPromptText"
                     Grid.Row="2"
                     Margin="2,10,2,4"
                     Foreground="#f0c96d"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Text="Enter a new user's details, then start enrollment."
                     TextWrapping="Wrap" />
          <TextBlock Name="EnrollmentProgressText"
                     Grid.Row="3"
                     Margin="2,0,2,8"
                     Foreground="#b9d7ef"
                     Text="0 of 5 angles captured" />
          <TextBlock Text="Registered users"
                     Grid.Row="4"
                     FontWeight="SemiBold"
                     Margin="2,4,0,8" />
          <ListBox Name="IdentityList"
                   Grid.Row="5"
                   Background="#0b1219"
                   Foreground="#f5f8fb"
                   BorderBrush="#243545"
                   SelectionChanged="IdentitySelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,5">
                  <TextBlock Text="{Binding DisplayName}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding PermissionLevel}"
                             Foreground="#80e0a4"
                             FontSize="12" />
                  <TextBlock Text="{Binding LastSeenAtUtc, StringFormat='Last seen {0:g}'}"
                             Foreground="#8ea8bc"
                             FontSize="11" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="#101820"
              BorderBrush="#243545"
              BorderThickness="1"
              CornerRadius="5"
              Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.2*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Background="#05090d"
                      BorderBrush="#37506a"
                      BorderThickness="1">
                <Grid>
                  <Image Name="ContextPhoto"
                         Stretch="Uniform" />
                  <TextBlock Name="NoPhotoText"
                             Text="No context photo is available yet."
                             Foreground="#8ea8bc"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="Collapsed" />
                </Grid>
              </Border>
              <Button Grid.Row="1"
                      Name="ReplacePhotoButton"
                      Content="Replace photo…"
                      Click="ReplacePhotoClicked"
                      Margin="0,10,0,0" />
            </Grid>
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="First name" FontWeight="SemiBold" />
              <TextBox Name="FirstNameTextBox"
                       Margin="0,5,0,10" />
              <TextBlock Text="Last name" FontWeight="SemiBold" />
              <TextBox Name="LastNameTextBox"
                       Margin="0,5,0,10" />
              <TextBlock Text="Username" FontWeight="SemiBold" />
              <TextBox Name="UsernameTextBox"
                       Margin="0,5,0,10" />
              <TextBlock Text="Email" FontWeight="SemiBold" />
              <TextBox Name="EmailTextBox"
                       Margin="0,5,0,10" />
              <TextBlock Text="Phone number" FontWeight="SemiBold" />
              <TextBox Name="PhoneNumberTextBox"
                       Margin="0,5,0,10" />
              <TextBlock Text="Address" FontWeight="SemiBold" />
              <TextBox Name="AddressTextBox"
                       Margin="0,5,0,14"
                       MinHeight="54"
                       AcceptsReturn="True"
                       TextWrapping="Wrap" />
              <CheckBox Name="RegisterAsUserCheckBox"
                        Content="Registered user"
                        Foreground="#f5f8fb"
                        Checked="RegistrationChanged"
                        Unchecked="RegistrationChanged" />
              <TextBlock Text="Permission level"
                         Margin="0,14,0,5"
                         FontWeight="SemiBold" />
              <ComboBox Name="PermissionLevelComboBox">
                <ComboBoxItem Content="Default User" />
                <ComboBoxItem Content="Superuser" />
              </ComboBox>
              <TextBlock Name="IdentityDetailText"
                         Margin="0,18,0,0"
                         Foreground="#b9d7ef"
                         TextWrapping="Wrap" />
              <Border Margin="0,18,0,0"
                      Padding="12"
                      Background="#0b1219"
                      BorderBrush="#243545"
                      BorderThickness="1"
                      CornerRadius="4">
                <StackPanel>
                  <TextBlock Text="Voice recognition"
                             FontWeight="SemiBold"
                             FontSize="15" />
                  <TextBlock Margin="0,10,0,4"
                             Text="Microphone input"
                             FontWeight="SemiBold" />
                  <ComboBox Name="VoiceMicrophoneComboBox"
                            DisplayMemberPath="Name"
                            SelectionChanged="VoiceMicrophoneSelectionChanged" />
                  <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Name="VoiceMicrophoneLevelMeter"
                                 Height="12"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#05090d"
                                 Foreground="#47c97d"
                                 BorderBrush="#37506a"
                                 BorderThickness="1" />
                    <TextBlock Name="VoiceMicrophoneLevelText"
                               Grid.Column="1"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#b9d7ef"
                               Text="0%" />
                  </Grid>
                  <TextBlock Name="VoiceMicrophoneStatusText"
                             Margin="0,5,0,0"
                             Foreground="#8ea8bc"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Text="Microphone stopped" />
                  <TextBlock Name="VoiceEnrollmentPromptText"
                             Margin="0,7,0,4"
                             Foreground="#f0c96d"
                             TextWrapping="Wrap"
                             Text="Select a registered user, then capture eight verified sentences." />
                  <TextBlock Name="VoiceEnrollmentProgressText"
                             Foreground="#b9d7ef"
                             Text="0 of 8 voice samples captured" />
                  <Border Name="VoiceEnrollmentResultBorder"
                          Margin="0,9,0,0"
                          Padding="9,7"
                          Background="#101820"
                          BorderBrush="#37506a"
                          BorderThickness="1"
                          CornerRadius="3">
                    <TextBlock Name="VoiceEnrollmentResultText"
                               Foreground="#b9d7ef"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="VOICE ENROLLMENT NOT STARTED" />
                  </Border>
                  <StackPanel Margin="0,10,0,0"
                              Orientation="Horizontal">
                    <Button Name="StartVoiceEnrollmentButton"
                            Content="Enroll voice"
                            Click="StartVoiceEnrollmentClicked"
                            Margin="0,0,8,0" />
                    <Button Name="CancelVoiceEnrollmentButton"
                            Content="Cancel voice enrollment"
                            Click="CancelVoiceEnrollmentClicked"
                            IsEnabled="False" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Margin="0,14,0,0"
                         Foreground="#f0c96d"
                         TextWrapping="Wrap"
                         Text="Superuser is a test/recovery label here. Avatar Builder does not enforce permissions, and Ali must require an independent owner recovery credential." />
            </StackPanel>
            </ScrollViewer>
          </Grid>
          <StackPanel Grid.Row="1"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Margin="0,16,0,0">
            <Button Content="New user"
                    Click="NewUserClicked"
                    Margin="0,0,8,0" />
            <Button Content="Start enrollment"
                    Name="StartEnrollmentButton"
                    Click="StartEnrollmentClicked"
                    Margin="0,0,8,0" />
            <Button Content="Create without camera"
                    Name="CreateWithoutCameraButton"
                    Click="CreateUserWithoutCameraClicked"
                    ToolTip="Create a permanent identity profile now. Face enrollment can be added later."
                    Margin="0,0,8,0" />
            <Button Content="Refresh"
                    Click="RefreshClicked"
                    Margin="0,0,8,0" />
            <Button Content="Save identity"
                    Click="SaveIdentityClicked"
                    Margin="0,0,8,0" />
            <Button Name="DeleteUserButton"
                    Content="Delete user"
                    Click="DeleteUserClicked"
                    Background="#5b1f25"
                    BorderBrush="#a94a55"
                    Margin="0,0,8,0" />
            <Button Content="Close"
                    Click="CloseClicked" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Name="StatusText"
               Grid.Row="2"
               Margin="0,12,0,0"
               Foreground="#80e0a4"
               TextWrapping="Wrap" />
  </Grid>
</Window>
