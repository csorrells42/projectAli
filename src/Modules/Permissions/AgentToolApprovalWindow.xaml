<Window x:Class="Ali.Modules.Permissions.AgentToolApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ali needs permission"
        Height="430"
        Width="760"
        MinHeight="390"
        MinWidth="700"
        MaxHeight="620"
        MaxWidth="980"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B0B0D"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#323236" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Padding="18"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushDark}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding TitleText}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1"
                       Text="{Binding DescriptionText}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="14"
                       LineHeight="21"
                       Margin="0,10,0,12"
                       TextWrapping="Wrap" />
            <Border Grid.Row="2"
                    Background="#101012"
                    BorderBrush="#34343A"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Requested arguments"
                                   Foreground="#8DDDF0"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ArgumentsText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontFamily="Cascadia Mono"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Always-allow choices apply only to this chat session and can be avoided by choosing Allow once."
                           Foreground="#F7C873"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                    <Button Content="Deny"
                            Background="#35171B"
                            BorderBrush="#9B3A43"
                            IsCancel="True"
                            Click="DenyButton_OnClick" />
                    <Button Content="Allow once"
                            Background="#163629"
                            BorderBrush="#2F8A60"
                            IsDefault="True"
                            Click="AllowOnceButton_OnClick" />
                    <Button Content="Always exact action"
                            ToolTip="Allow this tool only when every argument is exactly the same during this chat."
                            Click="AlwaysArgumentsButton_OnClick" />
                    <Button Content="Always this tool"
                            ToolTip="Allow all calls to this tool during this chat, regardless of arguments."
                            Click="AlwaysToolButton_OnClick" />
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
