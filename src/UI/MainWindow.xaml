<Window x:Class="Ali.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Ali.UI.ViewModels"
        xmlns:controls="clr-namespace:Ali.UI.Controls"
        mc:Ignorable="d"
        Title="{Binding AssistantWindowTitle}"
        Icon="/Ali;component/Assets/ali.ico"
        Height="980"
        MinHeight="820"
        Width="1600"
        MinWidth="1349"
        Background="#0B0B0D"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0D" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#121214" />
        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202024" />
        <SolidColorBrush x:Key="InputBrush" Color="#0F0F11" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#323236" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9DA4AE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00BEE6" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#24404A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F8FAFC" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#202024" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F8FAFC" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Margin="9,0,30,0"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{StaticResource MutedTextBrush}"
                                  HorizontalAlignment="Right"
                                  IsHitTestVisible="False"
                                  Margin="0,0,10,0"
                                  Stretch="Fill"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="4" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1">
                                        <ScrollViewer CanContentScroll="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#5A5A63" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter TargetName="ComboChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#303036" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#24404A" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#19546A" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:CommandExplorerNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Title}"
                       Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis"
                       Padding="2" />
        </HierarchicalDataTemplate>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="ComposerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="#2F2F32" />
            <Setter Property="BorderBrush" Value="#3B3B40" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SidebarActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="ChatActionLinkButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#66D9EF" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="12"
                                   Padding="{TemplateBinding Padding}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
                                <Setter Property="Foreground" Value="#B8F2FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#66707A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="MenuItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" />
                                    <TextBlock x:Name="CheckIndicator"
                                               Grid.Column="1"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#8EE6B5"
                                               Visibility="Collapsed"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="SubmenuIndicator"
                                               Grid.Column="2"
                                               Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#B9D7EF"
                                               Visibility="Collapsed"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Right"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="#4C7598"
                                        BorderThickness="1"
                                        MinWidth="190"
                                        Padding="2">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#243F58" />
                                <Setter TargetName="MenuItemBorder" Property="BorderBrush" Value="#4C7598" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#183149" />
                                <Setter TargetName="MenuItemBorder" Property="BorderBrush" Value="#4C7598" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubmenuIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,3" />
            <Setter Property="Background" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResourceMeterProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="#22C55E" />
            <Setter Property="Background" Value="#303136" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding HistorySidebarColumnWidth}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Menu Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Background="{StaticResource PanelBrush}"
              Foreground="{StaticResource TextBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_Identity Review..." Click="OpenIdentityReviewMenuItem_OnClick" />
                <MenuItem Header="_Choose Data Folder..." Click="OpenDataFolderMenuItem_OnClick" />
                <MenuItem Header="_Identity Engine">
                    <MenuItem Header="_CPU" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="_DirectML GPU" IsCheckable="True" IsEnabled="False" ToolTip="GPU identity remains held back until its recognition path passes validation." />
                </MenuItem>
                <MenuItem Header="_Speech to Text">
                    <MenuItem Header="_Parakeet"
                              IsCheckable="True"
                              IsChecked="{Binding ParakeetSpeechToTextSelected, Mode=OneWay}"
                              Command="{Binding SelectParakeetSpeechToTextCommand}" />
                    <MenuItem Header="_Whisper"
                              IsCheckable="True"
                              IsChecked="{Binding WhisperSpeechToTextSelected, Mode=OneWay}"
                              Command="{Binding SelectWhisperSpeechToTextCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Frame Pipeline _Timing..."
                          ToolTip="Opens a table that requests each module's current waited and worked times once per second."
                          Click="OpenPipelineTimingMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="E_xit" Click="CloseMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Show _Tracking Overlay"
                          IsCheckable="True"
                          IsChecked="{Binding TrackingOverlayEnabled, Mode=TwoWay}" />
                <MenuItem Header="Show Face _Mesh Overlay"
                          IsCheckable="True"
                          IsChecked="{Binding FaceMeshOverlayEnabled, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="_No Optional Overlays" Command="{Binding NoOptionalOverlaysCommand}" />
                <MenuItem Header="Show _All Optional Overlays" Command="{Binding AllOptionalOverlaysCommand}" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                Padding="14"
                Visibility="{Binding IsHistorySidebarVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                        Background="#05070A"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="1"
                        Margin="0,0,0,8"
                        ClipToBounds="True">
                    <controls:AspectRatioDecorator AspectRatio="1.7777777778">
                        <Grid Background="#05070A">
                            <ContentControl Content="{Binding VisionViewport}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch" />
                            <TextBlock Text="Camera off"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VisionCameraOn}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </controls:AspectRatioDecorator>
                        </Border>

                        <Button Grid.Row="1"
                        Content="Expand Webcam"
                        Click="ExpandWebcam_OnClick"
                        IsEnabled="{Binding VisionCameraOn}"
                        HorizontalAlignment="Stretch"
                        Margin="0"
                        ToolTip="Available while the camera is on. Moves the existing viewport into a resizable window." />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Recents"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,4,0,6" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding ConversationHistory}"
                         SelectedItem="{Binding SelectedConversationHistoryItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConversationHistoryItemViewModel}">
                            <Border BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,5"
                                    Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#202C33" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Visibility="{Binding IsViewing, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Preview}"
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <DockPanel Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button DockPanel.Dock="Right"
                                                Content="OK"
                                                Command="{Binding DataContext.CommitConversationRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Height="26"
                                                MinHeight="26"
                                                Padding="8,0"
                                                Margin="6,0,0,0" />
                                        <TextBox Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="26"
                                                 Margin="0"
                                                 Padding="6,3" />
                                    </DockPanel>

                                    <Button Grid.Column="1"
                                            Content="..."
                                            Style="{StaticResource SidebarActionButton}"
                                            Click="HistoryMenuButton_OnClick"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Chat actions">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename"
                                                          Command="{Binding PlacementTarget.Tag.RenameConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Erase chat"
                                                          Command="{Binding PlacementTarget.Tag.EraseConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Search"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="New chat"
                                Command="{Binding NewChatCommand}"
                                HorizontalContentAlignment="Center"
                                MinWidth="110"
                                Margin="0" />
                    </Grid>
                    <TextBox Text="{Binding ConversationSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search saved local chat titles and message text"
                             Margin="0,0,0,8"
                             MinHeight="32" />
                    <Button Content="Erase History"
                            Command="{Binding EraseHistoryCommand}"
                            HorizontalContentAlignment="Center"
                            Margin="0"
                            BorderBrush="#7F1D1D"
                            Background="#2A1517"
                            ToolTip="Erase saved local conversations and recent chat entries after confirmation." />
                </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="240" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsCameraBarExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Camera" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding VisionCameras}" SelectedItem="{Binding SelectedVisionCamera}" />
                    <TextBlock Grid.Column="2" Text="Mode" VerticalAlignment="Center" Margin="14,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding VisionCameraModes}" SelectedItem="{Binding SelectedVisionCameraMode}" />
                    <Button Grid.Column="4" Content="{Binding VisionCameraButtonText}" Command="{Binding ToggleVisionCameraCommand}" Margin="14,0,0,0" />
                    <Button Grid.Column="5" Content="Refresh" Command="{Binding RefreshVisionCamerasCommand}" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="6" Text="{Binding VisionStatus}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#B9D7EF" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="7"
                            AutomationProperties.AutomationId="VisualAttentionToggleButton"
                            Content="{Binding VisualAttentionButtonText}"
                            Command="{Binding ToggleVisualAttentionCommand}"
                            ToolTip="{Binding VisualAttentionButtonToolTip}"
                            Background="{Binding VisualAttentionButtonBackground}"
                            BorderBrush="{Binding VisualAttentionButtonBorderBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            MinWidth="190"
                            Margin="14,0,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="0"
                    Height="44"
                    Margin="0,0,0,8"
                    Padding="14,0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               AutomationProperties.AutomationId="MainChatStatusText"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,14,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            BorderBrush="{Binding ModelConnectionStatusBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding ModelConnectionStatusBrush}"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ModelConnectionStatusText}"
                                       AutomationProperties.AutomationId="MainChatModelConnectionStatusText"
                                       Foreground="{Binding ModelConnectionStatusBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ItemsControl Grid.Column="2"
                                  AutomationProperties.AutomationId="MainChatStackStatus"
                                  ItemsSource="{Binding StackComponents}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StackComponentStatusViewModel}">
                                <Border BorderBrush="{Binding Brush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="6,3"
                                        Margin="0,0,5,0"
                                        ToolTip="{Binding ToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="{Binding Brush}"
                                                 Margin="0,0,4,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{Binding Brush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Column="3"
                                  ItemsSource="{Binding ResourceMeters}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ResourceMeterViewModel}">
                                <Border Width="66"
                                        Margin="0,0,12,0"
                                        ToolTip="{Binding ToolTip}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding Label}"
                                                       DockPanel.Dock="Left"
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayText}"
                                                       DockPanel.Dock="Right"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}"
                                                     Style="{StaticResource ResourceMeterProgress}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ToggleButton Grid.Column="4"
                                  AutomationProperties.AutomationId="MainChatCameraBarToggleButton"
                                  AutomationProperties.Name="Camera controls"
                                  IsChecked="{Binding IsCameraBarExpanded, Mode=TwoWay}"
                                  Height="34"
                                  Margin="0"
                                  Cursor="Hand"
                                  ToolTip="Show or hide camera controls.">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="CameraToggleChrome"
                                        Height="34"
                                        Padding="12,0"
                                        Background="#2A2A2E"
                                        BorderBrush="#46464D"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Camera"
                                                   Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" />
                                        <Path x:Name="CameraToggleChevron"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{StaticResource MutedTextBrush}"
                                              Width="8"
                                              Height="4"
                                              Margin="8,0,0,0"
                                              RenderTransformOrigin="0.5,0.5"
                                              Stretch="Fill"
                                              VerticalAlignment="Center">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CameraToggleChrome" Property="BorderBrush" Value="#5A5A63" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CameraToggleChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="CameraToggleChevron" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Button Grid.Column="5"
                            Content="Settings"
                            AutomationProperties.AutomationId="MainChatSettingsButton"
                            Command="{Binding OpenSettingsCommand}"
                            Height="34"
                            MinHeight="34"
                            Margin="8,0,0,0"
                            Padding="12,0"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="MessagesScrollViewer"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,8,0,8">
                <ItemsControl ItemsSource="{Binding Messages}" MaxWidth="840" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                            <StackPanel Margin="0,0,0,10"
                                        MaxWidth="760"
                                        HorizontalAlignment="{Binding MessageAlignment}">
                                <controls:MarkdownMessageView Markdown="{Binding Text}"
                                                              MessageTextAlignment="{Binding MessageTextAlignment}"
                                                              AutomationProperties.AutomationId="MainChatMessageText"
                                                              FontFamily="Segoe UI"
                                                              FontSize="15"
                                                              Foreground="{StaticResource TextBrush}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,3,0,0"
                                            HorizontalAlignment="{Binding MessageAlignment}"
                                            Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Content="Copy"
                                            Style="{StaticResource ChatActionLinkButton}"
                                            Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Copy message" />
                                    <Button Content="Flag as incorrect"
                                            Style="{StaticResource ChatActionLinkButton}"
                                            Command="{Binding DataContext.FlagIncorrectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0"
                                            Visibility="{Binding CanFlagAsIncorrect, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="Flagged for correction"
                                               Margin="10,0,0,0"
                                               Foreground="#FBBF24"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsFlaggedForCorrection, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ImageAttachmentViewModel}">
                            <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,8,8" Width="150">
                                <StackPanel>
                                    <Image Source="{Binding FilePath}" Height="74" Stretch="Uniform" />
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                                    <CheckBox Content="Retain" IsChecked="{Binding RetainAfterSession}" Margin="0,4,0,0" />
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Expander Grid.Column="0"
                          AutomationProperties.AutomationId="AliActivityPanel"
                          IsExpanded="{Binding IsAgentActivityExpanded, Mode=TwoWay}"
                          Foreground="{StaticResource TextBrush}"
                          Background="#151517"
                          BorderBrush="{StaticResource BorderBrushDark}"
                          BorderThickness="1"
                          MaxHeight="230"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Margin="0,0,12,8">
                    <Expander.Header>
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8C3;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#C5B3FF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AgentActivitySummary}"
                                       Foreground="#E2E8F0"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Expander.Header>
                    <Grid Margin="10,0,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Content="Clear"
                                Command="{Binding ClearAgentActivityCommand}"
                                HorizontalAlignment="Right"
                                MinHeight="24"
                                Height="24"
                                Padding="8,0"
                                Margin="0,0,0,4" />
                        <ScrollViewer Grid.Row="1" MaxHeight="170" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AgentActivities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AgentActivityItemViewModel}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{Binding Accent}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       Foreground="{Binding Accent}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Detail}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding TimingText}"
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    </Expander>

                    <StackPanel Grid.Column="1"
                                AutomationProperties.AutomationId="MainChatReasoningEffort"
                                Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,8,8"
                                ToolTip="GPT-OSS reasoning effort. Changes apply to the next request without reloading the model.">
                        <TextBlock Text="Effort"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,1" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Low"
                                         GroupName="ReasoningEffort"
                                         IsChecked="{Binding IsReasoningLow}"
                                         Foreground="{StaticResource TextBrush}"
                                         Margin="0,0,12,0" />
                            <RadioButton Content="Medium"
                                         GroupName="ReasoningEffort"
                                         IsChecked="{Binding IsReasoningMedium}"
                                         Foreground="{StaticResource TextBrush}"
                                         Margin="0,0,12,0" />
                            <RadioButton Content="High"
                                         GroupName="ReasoningEffort"
                                         IsChecked="{Binding IsReasoningHigh}"
                                         Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="#242426"
                        BorderBrush="#38383D"
                        BorderThickness="1"
                        CornerRadius="26"
                        Padding="8"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ComposerTextBox"
                                 AutomationProperties.AutomationId="MainChatComposerTextBox"
                                 Grid.Column="0"
                                 Language="en-US"
                                 SpellCheck.IsEnabled="True"
                                 MinHeight="44"
                                 MaxHeight="150"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="6,0"
                                 Padding="8,10"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Spelling is checked as you type. Right-click an underlined word for suggestions."
                                 Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="ComposerTextBox_OnPreviewKeyDown" />

                        <Button Grid.Column="1"
                                x:Name="PushToTalkButton"
                                AutomationProperties.AutomationId="MainChatPushToTalkButton"
                                Content="{Binding PushToTalkKeyButtonText}"
                                Command="{Binding TogglePushToTalkCommand}"
                                ToolTip="{Binding PushToTalkHintText}"
                                PreviewMouseLeftButtonDown="PushToTalkButton_OnPreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="PushToTalkButton_OnPreviewMouseLeftButtonUp"
                                LostMouseCapture="PushToTalkButton_OnLostMouseCapture"
                                Style="{StaticResource ComposerButton}"
                                VerticalAlignment="Bottom"
                                MinWidth="116" />
                        <Grid Grid.Column="2"
                              MinWidth="92"
                              Margin="4,0,0,0"
                              VerticalAlignment="Bottom">
                            <Button
                                    AutomationProperties.AutomationId="MainChatSendButton"
                                    Content="{Binding SendButtonText}"
                                    Command="{Binding SendCommand}"
                                    ToolTip="{Binding SendButtonToolTip}"
                                    Style="{StaticResource ComposerButton}"
                                    Background="{Binding SendButtonBackground}"
                                    BorderBrush="{Binding SendButtonBorderBrush}"
                                    MinWidth="92" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="6,8,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AttachmentStatus}"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,28,0" />
                    <Grid Grid.Column="1" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,20,0"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock AutomationProperties.AutomationId="MainChatVoiceStatusText"
                                           Text="{Binding VoiceStatus}"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="390"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0" />
                                <TextBlock Text="Speech speed"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Slider Minimum="0.75"
                                        Maximum="1.6"
                                        Width="125"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        SmallChange="0.05"
                                        LargeChange="0.1"
                                        Value="{Binding SpeechRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SpeechRateLabel}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           MinWidth="38"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <CheckBox Content="Read replies aloud"
                                      IsChecked="{Binding AssistantReadsRepliesOutLoud, Mode=TwoWay}"
                                      ToolTip="{Binding VoiceReadAloudToolTip}"
                                      Margin="0,0,0,3" />
                            <CheckBox Content="Enable PTT"
                                      AutomationProperties.AutomationId="MainChatEnablePttCheckBox"
                                      IsChecked="{Binding AutoSendVoiceTranscripts, Mode=TwoWay}"
                                      ToolTip="{Binding PushToTalkEnabledToolTip}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Grid.Column="2"
                Width="560"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1,0,0,0"
                Padding="14"
                Visibility="{Binding IsCommandExplorerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Commands"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Feature and command explorer"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Close"
                            Command="{Binding ToggleCommandExplorerCommand}"
                            Height="30"
                            MinHeight="30"
                            Padding="10,0"
                            Margin="8,0,0,0"
                            VerticalAlignment="Top" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TreeView Grid.Column="0"
                              ItemsSource="{Binding CommandExplorerRoots}"
                              SelectedItemChanged="CommandExplorerTree_OnSelectedItemChanged"
                              BorderThickness="1"
                              Padding="6" />

                    <Border Grid.Column="1"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="14"
                            Margin="12,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding SelectedCommandExplorerNode.Title}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding SelectedCommandExplorerNode.Summary}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,12" />
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Usage"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5" />
                                <TextBox Text="{Binding SelectedCommandExplorerNode.Usage, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="90"
                                         Margin="0"
                                         VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="Command"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,5"
                                           Visibility="{Binding SelectedCommandExplorerNode.IsCommand, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBox Text="{Binding SelectedCommandExplorerNode.CommandText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Margin="0"
                                         Visibility="{Binding SelectedCommandExplorerNode.IsCommand, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <Button Grid.Row="3"
                                    Content="Use Command"
                                    Command="{Binding RunSelectedCommandExplorerCommand}"
                                    CommandParameter="{Binding SelectedCommandExplorerNode}"
                                    HorizontalAlignment="Right"
                                    Padding="14,8"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding SelectedCommandExplorerNode.IsCommand, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

