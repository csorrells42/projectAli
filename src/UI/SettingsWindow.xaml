                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Maintenance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBackgroundBrush}">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,12,10,0">
                        <StackPanel>
                            <TextBlock Text="Computer Maintenance"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Run a read-only health check for Ali's install, local computer assistant lanes, PDF tools, internet source backend, local library, and recent receipts."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,12" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,14">
                                <Button Content="Run Health Check"
                                        Command="{Binding RunComputerHealthCheckCommand}"
                                        MinWidth="148"
                                        Margin="0,0,10,0" />
                                <Button Content="Repair Ali Install"
                                        Command="{Binding RepairAliInstallCommand}"
                                        MinWidth="148"
                                        BorderBrush="#8A6A18"
                                        Background="#2A2415"
                                        Margin="0,0,10,0" />
                                <Button Content="Assistant Setup"
                                        Command="{Binding RunComputerAssistantSetupCommand}"
                                        MinWidth="148"
                                        Margin="0,0,10,0" />
                                <Button Content="Maintenance Plan"
                                        Command="{Binding RunMaintenancePlanCommand}"
                                        MinWidth="148" />
                            </StackPanel>

                            <Border Height="1"
                                    Background="{StaticResource BorderBrushDark}"
                                    Margin="0,0,0,14" />

                            <TextBlock Text="Backup &amp; Restore"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Create a zip backup of Ali's user data, or restore one after reinstalling. Ollama models are not included or changed."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,12" />

                            <Border Background="#14191C"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Included"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Conversations, memories, reminders, assistant profile/name, app settings, sources/topics, local library settings and index metadata, voice settings, runtime/model selection settings, receipts, and generated documents."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Temporary session audio and temporary screenshots are skipped."
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                <Button Content="Create Backup"
                                        Command="{Binding BackupUserDataCommand}"
                                        MinWidth="130"
                                        Margin="0,0,10,0" />
                                <Button Content="Restore Backup"
                                        Command="{Binding RestoreUserDataCommand}"
                                        MinWidth="130"
                                        BorderBrush="#7F1D1D"
                                        Background="#2A1517" />
                            </StackPanel>

                            <Border BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding MaintenanceStatusText}"
                                               Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MaintenanceReceiptPath, StringFormat=Maintenance receipts: {0}}"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="InternetTab"
                     Header="Internet"
                     AutomationProperties.AutomationId="SettingsInternetTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBackgroundBrush}">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,12,10,0">
                        <StackPanel>
                            <TextBlock Text="Internet Source Backend"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding InternetBackendStatusText}"
                                       AutomationProperties.AutomationId="SettingsInternetBackendStatusText"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Sources" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding ConfiguredSourcesText}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2"
                                        Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Topics" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding ConfiguredTopicsText}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <CheckBox Content="Enable internet source backend"
                                      AutomationProperties.AutomationId="SettingsInternetBackendEnabledCheckBox"
                                      IsChecked="{Binding InternetBackendEnabled}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Tavily API key" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InternetTavilyApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="SettingsInternetTavilyApiKeyTextBox"
                                     Margin="0,2,0,2" />
                            <TextBlock Text="Primary current-events, weather, and news search. Leave blank to use TAVILY_API_KEY from the environment."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding InternetTavilyUsageText}"
                                       AutomationProperties.AutomationId="SettingsInternetTavilyUsageText"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0" />
                            <Button Content="Test Tavily"
                                    AutomationProperties.AutomationId="SettingsInternetTestTavilyButton"
                                    Command="{Binding TestTavilyInternetBackendCommand}"
                                    HorizontalAlignment="Left"
                                    MinWidth="112"
                                    Margin="0,6,0,12" />

                            <TextBlock Text="Firecrawl API key" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InternetFirecrawlApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="SettingsInternetFirecrawlApiKeyTextBox"
                                     Margin="0,2,0,2" />
                            <TextBlock Text="Page extraction and first fallback search. Leave blank to use FIRECRAWL_API_KEY from the environment."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding InternetFirecrawlUsageText}"
                                       AutomationProperties.AutomationId="SettingsInternetFirecrawlUsageText"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0" />
                            <Button Content="Test Firecrawl"
                                    AutomationProperties.AutomationId="SettingsInternetTestFirecrawlButton"
                                    Command="{Binding TestFirecrawlInternetBackendCommand}"
                                    HorizontalAlignment="Left"
                                    MinWidth="122"
                                    Margin="0,6,0,12" />

                            <TextBlock Text="Brave Search API key" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InternetBraveSearchApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="SettingsInternetBraveSearchApiKeyTextBox"
                                     Margin="0,2,0,2" />
                            <TextBlock Text="Second fallback search. Leave blank to use BRAVE_SEARCH_API_KEY from the environment."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding InternetBraveSearchUsageText}"
                                       AutomationProperties.AutomationId="SettingsInternetBraveSearchUsageText"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0" />
                            <Button Content="Test Brave"
                                    AutomationProperties.AutomationId="SettingsInternetTestBraveSearchButton"
                                    Command="{Binding TestBraveSearchInternetBackendCommand}"
                                    HorizontalAlignment="Left"
                                    MinWidth="112"
                                    Margin="0,6,0,12" />

                            <TextBlock Text="Serper API key" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InternetSerperApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="SettingsInternetSerperApiKeyTextBox"
                                     Margin="0,2,0,2" />
                            <TextBlock Text="Final fallback Google results API. Leave blank to use SERPER_API_KEY from the environment."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding InternetSerperUsageText}"
                                       AutomationProperties.AutomationId="SettingsInternetSerperUsageText"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0" />
                            <Button Content="Test Serper"
                                    AutomationProperties.AutomationId="SettingsInternetTestSerperButton"
                                    Command="{Binding TestSerperInternetBackendCommand}"
                                    HorizontalAlignment="Left"
                                    MinWidth="112"
                                    Margin="0,6,0,12" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="Save"
                                        Command="{Binding SaveInternetBackendSettingsCommand}"
                                        Width="86"
                                        Margin="0,0,8,0" />
                                <Button Content="Test primary"
                                        AutomationProperties.AutomationId="SettingsInternetTestConfiguredButton"
                                        Command="{Binding TestConfiguredInternetBackendsCommand}"
                                        MinWidth="126"
                                        Margin="0" />
                            </StackPanel>

                            <Border BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    Padding="10"
                                    Margin="0,12,0,0">
                                <TextBlock Text="{Binding InternetBackendSettingsPath}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>

