                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,8,0,0" />

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0">
                                    <Button Content="Save"
                                            Command="{Binding SaveRuntimeSettingsCommand}"
                                            Width="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Check"
                                            Command="{Binding CheckRuntimeCommand}"
                                            Width="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Recommend"
                                            Command="{Binding RecommendRuntimeSettingsCommand}"
                                            Width="112"
                                            Margin="0,0,8,0"
                                            ToolTip="Estimate low, medium, and aggressive settings for the selected model and this computer." />
                                    <Button Content="Activate"
                                            Command="{Binding ActivateRuntimeCommand}"
                                            IsEnabled="{Binding CanActivateRuntime}"
                                            Width="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Stub"
                                            Command="{Binding RevertToStubCommand}"
                                            Width="86"
                                            Margin="0" />
                                </StackPanel>

                                <Border BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        Padding="10"
                                        Margin="0,12,0,0">
                                    <TextBlock Text="{Binding RuntimeHealthResult}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Voice / Mic"
                     AutomationProperties.AutomationId="SettingsVoiceMicTab">
