                                            MinWidth="76"
                                            Margin="0,0,8,0" />
                                    <Button Content="Clear Reminders"
                                            Command="{Binding ClearRemindersCommand}"
                                            MinWidth="126"
                                            BorderBrush="#7F1D1D"
                                            Background="#2A1517" />
