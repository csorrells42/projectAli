<Window x:Class="Ali.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AssistantSettingsWindowTitle}"
        Height="700"
        Width="960"
        MinHeight="620"
        MinWidth="840"
        Background="#0B0B0D"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202024" />
        <SolidColorBrush x:Key="InputBrush" Color="#0F0F11" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#323236" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9DA4AE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00BEE6" />

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#34343A" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#5A5A63" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#202024" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#17171A" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#303036" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter TargetName="TextBoxChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="#303036" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46464D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="ComboRoot"
                              SnapsToDevicePixels="True"
                              TextElement.Foreground="{TemplateBinding Foreground}">
                            <Border x:Name="ComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Margin="9,0,30,0"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                            <Path x:Name="DropDownArrow"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{StaticResource MutedTextBrush}"
                                  HorizontalAlignment="Right"
                                  IsHitTestVisible="False"
                                  Margin="0,0,10,0"
                                  Stretch="Fill"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="4" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1">
                                        <ScrollViewer CanContentScroll="True"
                                                      Padding="0">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#5A5A63" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="DropDownArrow" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter TargetName="ComboRoot" Property="TextElement.Foreground" Value="#8B929E" />
                                <Setter TargetName="ComboChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#303036" />
                                <Setter TargetName="DropDownArrow" Property="Fill" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#24323A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#1D3B45" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#4B5563" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Background="{TemplateBinding Background}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#6B7280" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#111114" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="ScrollRoot"
                              Background="{TemplateBinding Background}"
                              SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{TemplateBinding Foreground}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="14" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="ScrollRoot" Property="MinHeight" Value="14" />
                                <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#303036" />
                                <Setter Property="Background" Value="#0F0F11" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid ClipToBounds="False" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Margin="0,0,0,-1"
                                      Panel.ZIndex="1" />
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,1,0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="TabChrome" Property="Background" Value="#24242A" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#202024" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B929E" />
                                <Setter TargetName="TabChrome" Property="Background" Value="#151518" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#303036" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Local runtime, voice, and microphone controls." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <TabControl x:Name="SettingsTabs"
                    Grid.Row="1"
                    Margin="0"
                    Padding="0"
                    ClipToBounds="False">
            <TabItem x:Name="RuntimeTab" Header="Runtime">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBackgroundBrush}">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,12,10,0">
                        <StackPanel>
                            <TextBlock Text="Runtime Settings"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding RuntimeDisplay}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,10" />
                            <TextBlock Text="{Binding ActiveRuntimeStatus}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,10" />

                            <Border Background="#201819"
                                    BorderBrush="#684044"
                                    BorderThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Advanced runtime settings"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="These settings can break local model startup, slow the assistant down, or make owner testing confusing if changed accidentally."
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,3,0,8" />
                                    <CheckBox x:Name="RuntimeAdvancedUnlockCheck"
                                              Content="I understand. Enable runtime settings."
                                              ToolTip="Check this only when intentionally changing local runtime settings." />
                                </StackPanel>
                            </Border>

                            <Border Background="#101B22"
                                    BorderBrush="#31566B"
                                    BorderThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Effective runtime request contract"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Read-only safety flags generated from the same policy used by the connector."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,2,0,7" />
                                    <TextBlock Text="{Binding RuntimeRequestContractText}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Foreground="#C7E7F5" />
                                </StackPanel>
                            </Border>

                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=RuntimeAdvancedUnlockCheck}"
                                        Margin="0,0,4,0">
                                <TextBlock Text="Runtime engine" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding RuntimeEngineChoices}"
                                          SelectedItem="{Binding SelectedRuntimeEngine}"
                                          Margin="0,2,0,2" />
                                <TextBlock Text="Lemonade uses an unload-and-verify barrier before another model can be checked."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Endpoint" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RuntimeEndpointText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,2" />
                                <Button Content="Refresh"
                                        Command="{Binding RefreshRuntimeModelsCommand}"
                                        Width="86"
                                        Padding="8,5"
                                        HorizontalAlignment="Right"
                                        Margin="0,4,0,2"
                                        ToolTip="Refresh installed model choices from the endpoint." />
                                <TextBlock Text="Local OpenAI-compatible URL. Leave this on localhost for owner testing."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Installed model" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding RuntimeModelChoices}"
                                          SelectedItem="{Binding SelectedRuntimeModelChoice}"
                                          Margin="0,2,0,4" />
                                <TextBlock Text="{Binding AssistantWillUseSelectedModelText}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding RuntimeSelectionStatusText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Quantization" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding RuntimeQuantizationChoices}"
                                          SelectedItem="{Binding RuntimeQuantizationText}"
                                          Margin="0,2,0,2" />
                                <TextBlock Text="Model packaging/performance profile. Usually leave this on the installed default."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,0,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Context" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding RuntimeContextChoices}"
                                                  SelectedItem="{Binding RuntimeContextText}"
                                                  Margin="0,2,0,2" />
                                        <TextBlock Text="Memory window; higher uses more RAM."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Output" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding RuntimeOutputLimitChoices}"
                                                  SelectedItem="{Binding RuntimeOutputLimitText}"
                                                  Margin="0,2,0,2" />
                                        <TextBlock Text="Max reply length in tokens."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding RuntimeTemperatureChoices}"
                                                  SelectedItem="{Binding RuntimeTemperatureText}"
                                                  Margin="0,2,0,2"
                                                  ToolTip="Lower is steadier. Use 0.0-1.0 for normal assistant testing." />
                                        <TextBlock Text="Lower is steadier; presets stay in range."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Top-p" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding RuntimeTopPChoices}"
                                                  SelectedItem="{Binding RuntimeTopPText}"
                                                  Margin="0,2,0,2"
                                                  ToolTip="Optional nucleus sampling value. Use model default unless tuning is needed." />
                                        <TextBlock Text="Sampling cutoff; default is usually best."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <CheckBox Content="Streaming responses"
                                                  IsChecked="{Binding RuntimeStreamingEnabled}"
                                                  Margin="0,0,0,2"
                                                  ToolTip="User selectable. Shows response text as it arrives." />
                                        <TextBlock Text="User selectable; shows response text as it arrives."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <CheckBox Content="Vision/image support"
                                                  IsChecked="{Binding RuntimeVisionEnabled}"
                                                  Margin="0,0,0,2"
                                                  ToolTip="User selectable. Enable only for image-capable models." />
                                        <TextBlock Text="User selectable; enable only for image-capable models."
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Stop markers and model packaging remain controlled by the selected runtime engine."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,8,0,0" />

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0">
                                    <Button Content="Save"
                                            Command="{Binding SaveRuntimeSettingsCommand}"
                                            Width="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Check"
                                            Command="{Binding CheckRuntimeCommand}"
                                            Width="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Recommend"
                                            Command="{Binding RecommendRuntimeSettingsCommand}"
                                            Width="112"
                                            Margin="0,0,8,0"
                                            ToolTip="Estimate low, medium, and aggressive settings for the selected model and this computer." />
                                    <Button Content="Activate"
                                            Command="{Binding ActivateRuntimeCommand}"
                                            IsEnabled="{Binding CanActivateRuntime}"
                                            Width="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Stub"
                                            Command="{Binding RevertToStubCommand}"
                                            Width="86"
                                            Margin="0" />
