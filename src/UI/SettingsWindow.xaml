                                <Ellipse Width="14"
                                         Height="14"
                                         Fill="#42D77D"
                                         Stroke="{StaticResource MutedTextBrush}"
                                         StrokeThickness="1"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />
                                <TextBlock Text="DSP active"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Row="2"
                                    MinHeight="130"
                                    Background="#05070A"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    Margin="0,0,0,10">
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="720"
                                            Height="130"
                                            ClipToBounds="True"
                                            SnapsToDevicePixels="True">
                                        <Polyline Points="{Binding SpectrumLivePoints}"
                                                  Stroke="#00BEE6"
                                                  StrokeThickness="2.5"
                                                  StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <TextBlock Grid.Row="3"
                                       Text="Processed signal being monitored"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />
                            <StackPanel Grid.Row="4">
                                <TextBlock Text="{Binding VoiceInputMeterText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                                <TextBlock Text="{Binding VoiceDiagnosticsText}"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="420" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Sound output"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding VoiceOutputDevices}"
                                          SelectedItem="{Binding SelectedVoiceOutputDevice}"
                                          Height="30" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SelectedVoiceOutputDevice}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </Grid>

                            <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding AssistantVoiceLabel}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.AutomationId="SettingsTtsEngineComboBox"
                                      ItemsSource="{Binding TextToSpeechEngineChoices}"
                                      SelectedItem="{Binding TextToSpeechEngineText}"
                                      Height="30" />
                            <ComboBox Grid.Column="2"
                                      AutomationProperties.AutomationId="SettingsTtsVoiceComboBox"
                                      ItemsSource="{Binding TextToSpeechVoiceChoices}"
                                      SelectedItem="{Binding SelectedTextToSpeechVoiceChoice}"
                                      Height="30"
                                      Margin="8,0,0,0" />
                            <Button Grid.Column="3"
                                    Content="Hear Sample"
                                    AutomationProperties.AutomationId="SettingsHearVoiceSampleButton"
                                    Command="{Binding PlayVoiceSampleCommand}"
                                    MinWidth="112"
                                    Margin="12,0,12,0" />
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TtsStatus}"
                                           AutomationProperties.AutomationId="SettingsTtsStatusText"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                                <TextBlock Text="{Binding VoiceSettingsStatusText}"
                                           AutomationProperties.AutomationId="SettingsVoiceSettingsStatusText"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Corrections">
                <Grid Background="{StaticResource AppBackgroundBrush}" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Refresh"
                                        Command="{Binding RefreshCorrectionsCommand}"
                                        MinWidth="82"
                                        Margin="8,0,0,0" />
                                <Button Content="Reviewed"
                                        Command="{Binding MarkCorrectionReviewedCommand}"
                                        MinWidth="88"
                                        Margin="8,0,0,0" />
                                <Button Content="Unresolved"
                                        Command="{Binding MarkCorrectionUnresolvedCommand}"
                                        MinWidth="96"
                                        Margin="8,0,0,0" />
                                <Button Content="Export"
                                        Command="{Binding ExportSelectedCorrectionCommand}"
                                        MinWidth="78"
                                        Margin="8,0,0,0" />
                                <Button Content="Export All"
                                        Command="{Binding ExportAllCorrectionsCommand}"
                                        MinWidth="92"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding CorrectionReviewStatusText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox ItemsSource="{Binding CorrectionReviewItems}"
                                 SelectedItem="{Binding SelectedCorrectionReviewItem, Mode=TwoWay}"
                                 Background="{StaticResource PanelBrush}"
                                 BorderBrush="{StaticResource BorderBrushDark}"
                                 Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8"
                                            Margin="0,0,0,6"
                                            Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding DisplayStatus}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding CreatedAtText}"
                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                           FontSize="11" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding QuestionPreview}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding AnswerPreview}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Column="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedCorrectionReviewItem}">
                                    <TextBlock Text="{Binding Id}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ConversationText}"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10" />
                                    <TextBlock Text="{Binding RuntimeText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VoiceText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding AttachmentText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SafetyText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,14" />

                                    <TextBlock Text="Exact user question"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Question, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="90"
                                             Margin="0,6,0,12" />

                                    <TextBlock Text="Exact assistant answer"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Answer, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="160"
                                             Margin="0,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Memory / Reminders">
                <Grid Background="{StaticResource AppBackgroundBrush}" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Refresh"
                                    Command="{Binding RefreshMemoryRemindersCommand}"
                                    MinWidth="82"
                                    Margin="8,0,0,0" />
                            <TextBlock Text="{Binding MemoryReminderStatusText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Memory"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,0,0,10" />
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding MemoryEntries}"
                                         SelectedItem="{Binding SelectedMemoryEntry, Mode=TwoWay}"
                                         Background="{StaticResource InputBrush}"
                                         BorderBrush="{StaticResource BorderBrushDark}"
                                         Foreground="{StaticResource TextBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8"
                                                    Margin="0,0,0,6"
                                                    Background="{StaticResource PanelAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrushDark}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding UpdatedAtText}"
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               FontSize="11"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding SensitivityText}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Delete"
                                            Command="{Binding DeleteSelectedMemoryCommand}"
                                            MinWidth="82"
                                            Margin="0,0,8,0" />
                                    <Button Content="Clear Memories"
                                            Command="{Binding ClearMemoriesCommand}"
                                            MinWidth="118"
                                            BorderBrush="#7F1D1D"
                                            Background="#2A1517" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Local Reminders"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,0,0,10" />
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding ReminderEntries}"
                                         SelectedItem="{Binding SelectedReminderEntry, Mode=TwoWay}"
                                         Background="{StaticResource InputBrush}"
                                         BorderBrush="{StaticResource BorderBrushDark}"
                                         Foreground="{StaticResource TextBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8"
                                                    Margin="0,0,0,6"
                                                    Background="{StaticResource PanelAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrushDark}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding StatusText}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="11" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding DueAtText}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="12"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Complete"
