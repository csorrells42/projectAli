                                <Border BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        Padding="10"
                                        Margin="0,12,0,0">
                                    <TextBlock Text="{Binding RuntimeHealthResult}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}" />
