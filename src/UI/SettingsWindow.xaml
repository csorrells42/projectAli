                                           Text="{Binding SpectrumPeakText}"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />

                                <TextBlock Grid.Column="7"
                                           Text="{Binding PushToTalkKeyLabel}"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,8,0" />
