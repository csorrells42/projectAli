                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="General"
                     AutomationProperties.AutomationId="SettingsGeneralTab">
                <Grid Background="#05070A" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16,10"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Assistant name"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="This controls the wake phrase, prompts, and window titles. Renaming preserves the existing profile and user data."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,8" />
                                <TextBox Text="{Binding PendingAssistantName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="40"
                                         MinWidth="420"
                                         HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding AssistantRenameStatus}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Save name"
                                    Command="{Binding SaveAssistantNameCommand}"
                                    MinWidth="120"
                                    Margin="14,31,0,0"
                                    VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16,10">
                        <Grid>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Mic"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1"
                                          Grid.ColumnSpan="4"
                                          ItemsSource="{Binding VoiceInputDevices}"
                                          SelectedItem="{Binding SelectedVoiceInputDevice}"
                                          Height="30"
                                          MinWidth="520"
                                          ToolTip="{Binding SelectedVoiceInputDevice}"
                                          HorizontalContentAlignment="Left" />

                                <TextBlock Grid.Row="1"
                                           Text="Channel"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="14,10,8,0" />
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          ItemsSource="{Binding VoiceInputChannelModes}"
                                          SelectedItem="{Binding SelectedVoiceInputChannelMode}"
                                          Height="30"
                                          Margin="0,10,0,0" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="3"
                                           Text="{Binding PushToTalkKeyLabel}"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="14,10,8,0" />
                                <Button Grid.Row="1"
                                        Grid.Column="4"
                                        Content="{Binding AssignPushToTalkKeyButtonText}"
                                        Command="{Binding BeginAssignPushToTalkKeyCommand}"
                                        MinWidth="104"
                                        Margin="0,10,0,0"
                                        ToolTip="Click, then press the key you want to use for Push to Talk." />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,12,0,12">
                        <StackPanel>
                            <TextBlock Text="Microphone activity"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Height="18"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding VoiceInputLevelPercent, Mode=OneWay}"
                                             Background="#05090D"
                                             Foreground="#47C97D"
                                             BorderBrush="#37506A"
                                             BorderThickness="1" />
                                <TextBlock Grid.Column="1"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding VoiceInputLevelText}" />
                            </Grid>
                            <TextBlock Text="Speak normally. A moving green meter confirms that the selected microphone channel is delivering audio to Ali."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="{Binding VoiceDiagnosticsText}"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="420" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Sound output"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding VoiceOutputDevices}"
                                          SelectedItem="{Binding SelectedVoiceOutputDevice}"
                                          Height="30" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SelectedVoiceOutputDevice}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </Grid>

                            <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding AssistantVoiceLabel}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.AutomationId="SettingsTtsEngineComboBox"
                                      ItemsSource="{Binding TextToSpeechEngineChoices}"
                                      SelectedItem="{Binding TextToSpeechEngineText}"
                                      Height="30" />
                            <ComboBox Grid.Column="2"
                                      AutomationProperties.AutomationId="SettingsTtsVoiceComboBox"
                                      ItemsSource="{Binding TextToSpeechVoiceChoices}"
                                      SelectedItem="{Binding SelectedTextToSpeechVoiceChoice}"
                                      Height="30"
                                      Margin="8,0,0,0" />
                            <Button Grid.Column="3"
                                    Content="Hear Sample"
                                    AutomationProperties.AutomationId="SettingsHearVoiceSampleButton"
                                    Command="{Binding PlayVoiceSampleCommand}"
                                    MinWidth="112"
                                    Margin="12,0,12,0" />
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TtsStatus}"
                                           AutomationProperties.AutomationId="SettingsTtsStatusText"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                                <TextBlock Text="{Binding VoiceSettingsStatusText}"
                                           AutomationProperties.AutomationId="SettingsVoiceSettingsStatusText"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Corrections">
                <Grid Background="{StaticResource AppBackgroundBrush}" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Refresh"
                                        Command="{Binding RefreshCorrectionsCommand}"
                                        MinWidth="82"
                                        Margin="8,0,0,0" />
                                <Button Content="Reviewed"
                                        Command="{Binding MarkCorrectionReviewedCommand}"
                                        MinWidth="88"
                                        Margin="8,0,0,0" />
                                <Button Content="Unresolved"
                                        Command="{Binding MarkCorrectionUnresolvedCommand}"
                                        MinWidth="96"
                                        Margin="8,0,0,0" />
                                <Button Content="Export"
                                        Command="{Binding ExportSelectedCorrectionCommand}"
                                        MinWidth="78"
                                        Margin="8,0,0,0" />
                                <Button Content="Export All"
                                        Command="{Binding ExportAllCorrectionsCommand}"
                                        MinWidth="92"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding CorrectionReviewStatusText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox ItemsSource="{Binding CorrectionReviewItems}"
                                 SelectedItem="{Binding SelectedCorrectionReviewItem, Mode=TwoWay}"
                                 Background="{StaticResource PanelBrush}"
                                 BorderBrush="{StaticResource BorderBrushDark}"
                                 Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8"
                                            Margin="0,0,0,6"
                                            Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding DisplayStatus}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding CreatedAtText}"
                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                           FontSize="11" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding QuestionPreview}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding AnswerPreview}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Column="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedCorrectionReviewItem}">
                                    <TextBlock Text="{Binding Id}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ConversationText}"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10" />
                                    <TextBlock Text="{Binding RuntimeText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VoiceText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding AttachmentText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SafetyText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,14" />

                                    <TextBlock Text="Exact user question"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Question, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="90"
                                             Margin="0,6,0,12" />

                                    <TextBlock Text="Exact assistant answer"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Answer, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="160"
                                             Margin="0,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Long-Term Memory"
                     AutomationProperties.AutomationId="SettingsUserMemoryTab">
                <Grid Background="{StaticResource AppBackgroundBrush}" Margin="0,12,0,0" DataContext="{Binding UserMemorySettings}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Per-User Long-Term Memory" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Mem0 uses GPT-OSS through Lemonade and a separate Qdrant collection. Identity profile IDs—not display names—own memories."
                                           Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0" />
                                <TextBlock Text="{Binding StatusText}" Foreground="#64D8FF" TextWrapping="Wrap" Margin="0,6,12,0"
                                           AutomationProperties.AutomationId="SettingsUserMemoryStatusText" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Active identity profile" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveUserText}" Foreground="#FFCB6B" TextWrapping="Wrap" Margin="0,6,12,0"
                                           AutomationProperties.AutomationId="SettingsUserMemoryActiveProfileText" />
                                <TextBlock Text="Identity Review is the single place to select the active user. This page always follows that profile."
                                           Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Runtime and collection" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RuntimeStatus}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,6,12,0" />
                                <TextBlock Text="{Binding CollectionStatus}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,3,12,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="70" Margin="0,0,6,0" />
                                <Button Content="Test Connection" Command="{Binding TestCommand}" MinWidth="110" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Margin="0,0,8,8"
                                     ToolTip="Search only the active user's memories" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding CategoryFilter}"
                                      Margin="0,0,8,8" MinHeight="28" ToolTip="Optional category filter" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Search" Command="{Binding SearchCommand}" MinWidth="70" Margin="0,0,6,8" />
                                <Button Content="Review All" Command="{Binding RefreshCommand}" MinWidth="85" Margin="0,0,0,8" />
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Memories}" SelectedItem="{Binding SelectedMemory, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  Background="#0B1219" Foreground="#F5F8FB" RowBackground="#0B1219"
                                  AlternatingRowBackground="#121C26" AlternationCount="2" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#243545" MinHeight="210">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#0B1219" />
                                    <Setter Property="Foreground" Value="#F5F8FB" />
                                    <Style.Triggers>
                                        <Trigger Property="AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="#121C26" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1F4E68" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="6,4" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Memory" Binding="{Binding Text}" Width="*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="115" />
                                <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" Width="130" />
                                <DataGridTextColumn Header="Teaching" Binding="{Binding Explicit}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CorrectionText, UpdateSourceTrigger=PropertyChanged}" MinHeight="28"
                                     ToolTip="Edit the selected memory, then choose Correct" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Correct" Command="{Binding CorrectCommand}" MinWidth="72" Margin="0,0,6,0" />
                                <Button Content="Forget" Command="{Binding ForgetCommand}" MinWidth="72" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="The John Doe test profile is never merged into a future real profile. Camera and voice recognition select profiles; they are not high-assurance authentication."
                                   Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Export Current User" Command="{Binding ExportCommand}" MinWidth="125" Margin="0,0,6,0" />
                            <Button Content="Clear Test Profile" Command="{Binding ClearTestProfileCommand}" MinWidth="115" IsEnabled="{Binding IsTestProfile}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Memory / Calendar" Visibility="Collapsed">
                <Grid Background="{StaticResource AppBackgroundBrush}" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Refresh"
                                    Command="{Binding RefreshMemoryRemindersCommand}"
                                    MinWidth="82"
                                    Margin="8,0,0,0" />
                            <TextBlock Text="{Binding MemoryReminderStatusText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Memory"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,0,0,10" />
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding MemoryEntries}"
                                         SelectedItem="{Binding SelectedMemoryEntry, Mode=TwoWay}"
                                         Background="{StaticResource InputBrush}"
                                         BorderBrush="{StaticResource BorderBrushDark}"
                                         Foreground="{StaticResource TextBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8"
                                                    Margin="0,0,0,6"
                                                    Background="{StaticResource PanelAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrushDark}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding UpdatedAtText}"
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               FontSize="11"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding SensitivityText}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Delete"
                                            Command="{Binding DeleteSelectedMemoryCommand}"
                                            MinWidth="82"
                                            Margin="0,0,8,0" />
                                    <Button Content="Clear Memories"
                                            Command="{Binding ClearMemoriesCommand}"
                                            MinWidth="118"
                                            BorderBrush="#7F1D1D"
                                            Background="#2A1517" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Calendar Events"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Portable .ics files plus Windows notifications that remain scheduled when Ali is closed."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding ReminderEntries}"
                                         SelectedItem="{Binding SelectedReminderEntry, Mode=TwoWay}"
                                         Background="{StaticResource InputBrush}"
                                         BorderBrush="{StaticResource BorderBrushDark}"
                                         Foreground="{StaticResource TextBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8"
                                                    Margin="0,0,0,6"
                                                    Background="{StaticResource PanelAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrushDark}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding StatusText}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="11" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding DueAtText}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="12"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Complete"
                                            Command="{Binding CompleteSelectedReminderCommand}"
                                            MinWidth="86"
                                            Margin="0,0,8,0" />
                                    <Button Content="Cancel"
                                            Command="{Binding CancelSelectedReminderCommand}"
                                            MinWidth="76"
                                            Margin="0,0,8,0" />
                                    <Button Content="Clear Events"
                                            Command="{Binding ClearRemindersCommand}"
                                            MinWidth="126"
                                            BorderBrush="#7F1D1D"
                                            Background="#2A1517" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Backup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBackgroundBrush}">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,12,10,0">
                        <StackPanel>
                            <TextBlock Text="Backup &amp; Restore"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Create a zip backup of Ali's user data, or restore one after reinstalling. Lemonade models are not included or changed."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,12" />

                            <Border Background="#14191C"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Included"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Every persistent file under Ali's shared Data folder and the active user's profile folder, including conversations, Mem0/Qdrant metadata, identity/profile settings, permissions, runtime and voice settings, local-library metadata, receipts, and generated documents."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Temporary session audio and temporary screenshots are skipped."
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                <Button Content="Create Backup"
                                        Command="{Binding BackupUserDataCommand}"
                                        MinWidth="130"
                                        Margin="0,0,10,0" />
                                <Button Content="Restore Backup"
                                        Command="{Binding RestoreUserDataCommand}"
                                        MinWidth="130"
                                        BorderBrush="#7F1D1D"
                                        Background="#2A1517" />
                            </StackPanel>

                            <Border BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding MaintenanceStatusText}"
                                               Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MaintenanceReceiptPath, StringFormat=Backup audit: {0}}"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="MCP"
                     AutomationProperties.AutomationId="SettingsMcpTab">
                <Grid Background="{StaticResource AppBackgroundBrush}"
                      Margin="0,12,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Model Context Protocol Client"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Connect Ali to external MCP servers. Servers and tools remain off until you explicitly enable them."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,3,12,0" />
                                <TextBlock Text="{Binding McpSettings.StatusText}"
                                           AutomationProperties.AutomationId="SettingsMcpStatusText"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           Margin="0,7,12,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      Content="Enable MCP integrations"
                                      IsChecked="{Binding McpSettings.Enabled}"
                                      AutomationProperties.AutomationId="SettingsMcpEnabledCheckBox"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1"
                                Padding="0"
                                AutomationProperties.AutomationId="SettingsMcpWorkspaceTabs">
                        <TabItem Header="Connections">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="Servers"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" />
                                            <Button DockPanel.Dock="Right"
                                                    Content="Add"
                                                    Command="{Binding McpSettings.AddServerCommand}"
                                                    AutomationProperties.AutomationId="SettingsMcpAddServerButton"
                                                    Padding="10,4"
                                                    Margin="6,0,0,0" />
                                        </DockPanel>
                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding McpSettings.Servers}"
                                                 SelectedItem="{Binding McpSettings.SelectedServer, Mode=TwoWay}"
                                                 Background="{StaticResource InputBrush}"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource TextBrush}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrushDark}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="6,8">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Text="enabled"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding ConnectionSummary}"
                                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        Padding="14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel DataContext="{Binding McpSettings.SelectedServer}">
                                            <TextBlock Text="Connection Details"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <CheckBox Content="Enable this server"
                                                      IsChecked="{Binding Enabled}"
                                                      Margin="0,10,0,8" />

                                            <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="Transport" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding DataContext.McpSettings.TransportChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Transport, Mode=TwoWay}" />

                                            <Border Background="#14191C"
                                                    BorderBrush="{StaticResource BorderBrushDark}"
                                                    BorderThickness="1"
                                                    Padding="10"
                                                    Margin="0,8,0,10"
                                                    IsEnabled="{Binding IsHttp}">
                                                <StackPanel>
                                                    <TextBlock Text="HTTP / HTTPS server"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="Endpoint" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                                    <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.AutomationId="SettingsMcpEndpointTextBox" />
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Authentication header" Style="{StaticResource FieldLabel}" />
                                                            <TextBox Text="{Binding AuthenticationHeaderName, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Value prefix" Style="{StaticResource FieldLabel}" />
                                                            <TextBox Text="{Binding AuthenticationPrefix, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="Secret environment variable" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Text="{Binding AuthenticationEnvironmentVariable, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="Ali reads the secret from this environment variable when connecting. The secret itself is not saved."
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#14191C"
                                                    BorderBrush="{StaticResource BorderBrushDark}"
                                                    BorderThickness="1"
                                                    Padding="10"
                                                    Margin="0,0,0,10"
                                                    IsEnabled="{Binding IsStdio}">
                                                <StackPanel>
                                                    <TextBlock Text="Local stdio server"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="Command or executable" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                                    <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="Arguments (one argument per line)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Text="{Binding ArgumentsText, UpdateSourceTrigger=PropertyChanged}"
                                                             AcceptsReturn="True"
                                                             MinHeight="64"
                                                             VerticalScrollBarVisibility="Auto" />
                                                    <TextBlock Text="Working directory (optional)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                                    <CheckBox Content="Inherit Ali's process environment"
                                                              IsChecked="{Binding InheritEnvironmentVariables}"
                                                              Margin="0,6,0,2" />
                                                    <TextBlock Text="Environment mappings (TARGET_NAME=SOURCE_ENVIRONMENT_VARIABLE)"
                                                               Style="{StaticResource FieldLabel}" />
                                                    <TextBox Text="{Binding EnvironmentVariableBindingsText, UpdateSourceTrigger=PropertyChanged}"
                                                             AcceptsReturn="True"
                                                             MinHeight="58"
                                                             VerticalScrollBarVisibility="Auto" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="Connection timeout in seconds" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ConnectionTimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="100"
                                                     HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <StackPanel Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,10,0,0">
                                    <Button Content="Remove Selected"
                                            Command="{Binding McpSettings.RemoveServerCommand}"
                                            BorderBrush="#7F1D1D"
                                            Background="#2A1517"
                                            Margin="0,0,8,0" />
                                    <Button Content="Reload"
                                            Command="{Binding McpSettings.ReloadCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Test &amp; Discover Tools"
                                            Command="{Binding McpSettings.TestAndDiscoverCommand}"
                                            AutomationProperties.AutomationId="SettingsMcpTestButton"
                                            Margin="0,0,8,0" />
                                    <Button Content="Save MCP Settings"
                                            Command="{Binding McpSettings.SaveCommand}"
                                            AutomationProperties.AutomationId="SettingsMcpSaveButton"
                                            BorderBrush="{StaticResource AccentBrush}" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Tools">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Discovered Tools"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Test a connection first. Each discovered tool stays disabled and approval-gated until you choose otherwise. Server safety hints are informational only."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,10" />
                                    <TextBlock Text="{Binding McpSettings.SelectedServer.Name, StringFormat=Selected server: {0}}"
                                               Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding McpSettings.SelectedServer.Tools}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PanelBrush}"
                                                        BorderBrush="{StaticResource BorderBrushDark}"
                                                        BorderThickness="1"
                                                        Padding="12"
                                                        Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}" />
                                                            <TextBlock Text="{Binding Description}"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,4,12,0" />
                                                            <TextBlock Text="{Binding SafetySummary}"
                                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,5,12,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" MinWidth="160">
                                                            <CheckBox Content="Expose to Ali"
                                                                      IsChecked="{Binding Enabled}" />
                                                            <CheckBox Content="Ask before use"
                                                                      IsChecked="{Binding RequiresApproval}"
                                                                      Margin="0,8,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0">
                                    <Button Content="Refresh Discovery"
                                            Command="{Binding McpSettings.TestAndDiscoverCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Save Tool Permissions"
                                            Command="{Binding McpSettings.SaveCommand}"
                                            BorderBrush="{StaticResource AccentBrush}" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Safety">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16">
                                    <TextBlock Text="MCP Safety Boundary"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="An MCP server is external software. Its descriptions, tool results, and safety annotations are untrusted input. Ali never treats them as instructions."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,14" />
                                    <Border Background="#201819"
                                            BorderBrush="#684044"
                                            BorderThickness="1"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Safe defaults"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="• MCP is globally disabled until enabled here.&#x0a;• New servers are disabled.&#x0a;• Newly discovered tools are disabled and set to ask first.&#x0a;• A failed server is skipped without stopping Ali.&#x0a;• Secrets are read from named environment variables and are not placed in this settings file.&#x0a;• Tool names are namespaced by server to prevent collisions."
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Settings file"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,16,0,0" />
                                    <TextBox Text="{Binding McpSettings.SettingsPath, Mode=OneWay}"
                                             IsReadOnly="True" />
                                    <TextBlock Text="Removing approval from a tool means Ali may run it whenever the model selects it. Keep approval enabled for tools that write files, send messages, change accounts, spend money, execute commands, or modify external systems."
                                               Foreground="#F6C85F"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Agents"
                     AutomationProperties.AutomationId="SettingsAgentOrchestrationTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" DataContext="{Binding AgentOrchestrationSettings}">
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Agent Framework orchestration"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Ali remains the only user-facing personality. Specialist agents and workflows run synchronously on the same local-model path; concurrent and background agents are disabled."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="Magentic activation"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,14,0,0" />
                                <ComboBox ItemsSource="{Binding MagenticPolicyChoices}"
                                          SelectedItem="{Binding SelectedMagenticPolicy, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.AutomationId="SettingsMagenticPolicy" />
                                <TextBlock Text="{Binding SelectedMagenticPolicy.Summary}"
                                           Foreground="#F6C85F"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="Maximum Magentic coordination rounds"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,14,0,0" />
                                <ComboBox ItemsSource="{Binding MaximumRoundChoices}"
                                          SelectedItem="{Binding MagenticMaximumRounds, Mode=TwoWay}"
                                          Width="120"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.AutomationId="SettingsMagenticMaximumRounds" />
                                <TextBlock Text="Magentic is eligible only for open-ended multi-domain work that one specialist or an established workflow cannot handle. It is never selected merely because High effort is active."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Programming engines"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Ali stays in charge and remains the only user-facing personality. Choose which external engineering engine handles substantial coding work."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="Programming mode"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,0" />
                                <ComboBox ItemsSource="{Binding ProgrammingAgentModeChoices}"
                                          SelectedItem="{Binding SelectedProgrammingAgentMode, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.AutomationId="SettingsProgrammingAgentMode" />
                                <TextBlock Text="{Binding SelectedProgrammingAgentMode.Summary}"
                                           Foreground="#8DDDF0"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="OpenHands WSL distribution"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,0" />
                                <TextBox Text="{Binding OpenHandsWslDistribution, UpdateSourceTrigger=PropertyChanged}"
                                         Width="240"
                                         HorizontalAlignment="Left"
                                         AutomationProperties.AutomationId="SettingsOpenHandsWslDistribution" />
                                <TextBlock Text="Aider"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,0" />
                                <TextBlock Text="{Binding AiderStatusText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="OpenHands"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{Binding OpenHandsStatusText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <Button Content="Refresh provider status"
                                        Command="{Binding RefreshProgrammingAgentsCommand}"
                                        HorizontalAlignment="Right"
                                        Margin="0,12,0,0"
                                        AutomationProperties.AutomationId="SettingsRefreshProgrammingAgents" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Durable workflow checkpoints"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding CheckpointSummary}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="Checkpoint folder"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,10,0,0" />
                                <TextBox Text="{Binding CheckpointPath, Mode=OneWay}"
                                         IsReadOnly="True" />
                                <TextBlock Text="Settings file"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,10,0,0" />
                                <TextBox Text="{Binding SettingsPath, Mode=OneWay}"
                                         IsReadOnly="True" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14"
                                Margin="0,12,0,0"
                                DataContext="{Binding DataContext.ConversationBridgeSettings, RelativeSource={RelativeSource AncestorType=TabControl}}">
                            <StackPanel>
                                <TextBlock Text="Live Ali debugging bridge"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Lets Codex observe this exact on-screen conversation and submit text through the same send pipeline as the chat box. It is local-only, authenticated, and off by default. While the bridge is enabled, its trusted-controller permission decisions can be turned off separately below."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                                <CheckBox Content="Enable live Ali session bridge"
                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Foreground="{StaticResource TextBrush}"
                                          Margin="0,12,0,0"
                                          AutomationProperties.AutomationId="SettingsConversationBridgeEnabled" />
                                <CheckBox Content="Let the authenticated bridge decide visible permission prompts"
                                          IsChecked="{Binding AllowPermissionDecisions, Mode=TwoWay}"
                                          Foreground="{StaticResource TextBrush}"
                                          Margin="0,8,0,0"
                                          ToolTip="Only the exact currently pending request ID can be allowed or denied. Ali's normal permission and audit pipeline still applies."
                                          AutomationProperties.AutomationId="SettingsConversationBridgeApprovalControl" />
                                <TextBlock Text="Loopback port"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,10,0,0" />
                                <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="120"
                                         HorizontalAlignment="Left"
                                         AutomationProperties.AutomationId="SettingsConversationBridgePort" />
                                <TextBlock Text="Authenticated endpoint"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,10,0,0" />
                                <TextBox Text="{Binding Endpoint, Mode=OneWay}"
                                         IsReadOnly="True" />
                                <TextBlock Text="Bearer token"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,10,0,0" />
                                <TextBox Text="{Binding AuthenticationToken, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         AutomationProperties.AutomationId="SettingsConversationBridgeToken" />
                                <TextBlock Text="{Binding RuntimeState, StringFormat=State: {0}}"
                                           Foreground="#8DDDF0"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="#F6C85F"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="SettingsConversationBridgeStatus" />
                                <TextBlock Text="Settings file"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,10,0,0" />
                                <TextBox Text="{Binding SettingsPath, Mode=OneWay}"
                                         IsReadOnly="True" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,12,0,0">
                                    <Button Content="Reload"
                                            Command="{Binding ReloadCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="New Token"
                                            Command="{Binding RegenerateTokenCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Start"
                                            Command="{Binding StartCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Stop"
                                            Command="{Binding StopCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Save and apply"
                                            Command="{Binding SaveAndApplyCommand}"
                                            AutomationProperties.AutomationId="SettingsSaveConversationBridge" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#F6C85F"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   AutomationProperties.AutomationId="SettingsAgentOrchestrationStatus" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                            <Button Content="Reload"
                                    Command="{Binding ReloadCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Archive Checkpoints"
                                    Command="{Binding ArchiveCheckpointsCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Save"
                                    Command="{Binding SaveCommand}"
                                    AutomationProperties.AutomationId="SettingsSaveAgentOrchestration" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Permissions"
                     AutomationProperties.AutomationId="SettingsAgentPermissionsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{StaticResource AppBackgroundBrush}">
                <Grid Margin="12,12,22,12" DataContext="{Binding AgentToolPermissions}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Agent Framework Permissions"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Permission profile"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,10,0" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding PermissionProfileChoices}"
                                          SelectedItem="{Binding SelectedPermissionProfile, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.AutomationId="SettingsPermissionProfile" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ProfileSummary}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding CurrentUserText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="Allow once is never saved. Standing approvals are isolated to the active user and remain revocable here. Raw tool argument values and secrets are never written to this file."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding StatusText}"
                                       AutomationProperties.AutomationId="SettingsAgentPermissionsStatusText"
                                       Foreground="#F6C85F"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="Approved workstation roots"
                                       Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,9,0,0" />
                            <TextBlock Text="{Binding ApprovedFileRootsText}"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,3,0,0" />
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,3,0,0">
                                <Run Text="File action audit: " />
                                <Run Text="{Binding FileAuditPath, Mode=OneWay}" />
                                <Run Text="   •   Recoverable trash: " />
                                <Run Text="{Binding RecoverableTrashPath, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="Private Agent Framework work memory"
                                       Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,9,0,0" />
                            <TextBlock Text="Ali may freely keep intermediate notes and drafts here. Work memory is isolated by active user and conversation; it is separate from personal memory, indexed documents, and user-visible files."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,3,0,0">
                                <Run Text="Workspace root: " />
                                <Run Text="{Binding AgentWorkMemoryPath, Mode=OneWay}" />
                                <Run Text="   •   Audit: " />
                                <Run Text="{Binding AgentWorkMemoryAuditPath, Mode=OneWay}" />
                                <Run Text="   •   Recoverable trash: " />
                                <Run Text="{Binding AgentWorkMemoryTrashPath, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <GroupBox Grid.Row="1"
                              Header="Protected tools and current behavior"
                              Foreground="{StaticResource TextBrush}"
                              Margin="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ProtectedTools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ToolName}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Reason}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="12,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CurrentBehavior}"
                                                   Foreground="#F6C85F"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Content="{Binding EditButtonText}"
                                                Command="{Binding EditCommand}"
                                                MinWidth="132"
                                                Margin="14,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </GroupBox>

                    <GroupBox Grid.Row="2"
                              Header="Saved standing approvals"
                              Foreground="{StaticResource TextBrush}">
                    <Border
                            Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="8">
                        <ListBox ItemsSource="{Binding Grants}"
                                 SelectedItem="{Binding SelectedGrant, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 AutomationProperties.AutomationId="SettingsAgentPermissionsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1"
                                            Padding="12"
                                            Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ToolName}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ArgumentText}"
                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,12,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ScopeText}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="12,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding CreatedText}"
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    </GroupBox>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Saved permission file"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SettingsPath, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Margin="0,2,12,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">
                            <Button Content="Reload"
                                    Command="{Binding ReloadCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Revoke Selected"
                                    Command="{Binding RevokeSelectedCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Revoke All for User"
                                    Command="{Binding RevokeAllCommand}"
                                    Background="#2A1517"
                                    BorderBrush="#7F1D1D" />
                        </StackPanel>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="MCP Server"
                     AutomationProperties.AutomationId="SettingsMcpServerTab">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ali MCP Server"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Local Streamable HTTP host"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding McpServerSettings.RuntimeState}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding McpServerSettings.StatusText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="11" />
                            </StackPanel>
                            <CheckBox Grid.Column="3"
                                      Content="Enable MCP server"
                                      IsChecked="{Binding McpServerSettings.Enabled}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="SettingsMcpServerEnabledCheckBox" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Connection &amp; Security"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Endpoint"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,10,0,0" />
                                    <TextBox Text="{Binding McpServerSettings.Endpoint, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AutomationProperties.AutomationId="SettingsMcpServerEndpointTextBox" />

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Bind address" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding McpServerSettings.Host, Mode=OneWay}" IsReadOnly="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding McpServerSettings.PortText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Path" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding McpServerSettings.Path, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#14191C"
                                            BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1"
                                            Padding="10"
                                            Margin="0,12,0,0">
                                        <StackPanel>
                                            <CheckBox Content="Require bearer-token authentication"
                                                      IsChecked="{Binding McpServerSettings.RequireAuthentication}"
                                                      FontWeight="SemiBold" />
                                            <TextBlock Text="Token environment variable"
                                                       Style="{StaticResource FieldLabel}"
                                                       Margin="0,7,0,0" />
                                            <TextBox Text="{Binding McpServerSettings.AuthenticationEnvironmentVariable, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Ali reads the token only from this environment variable. The secret is never written to the settings file."
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <CheckBox Content="Use stateless HTTP sessions (advanced)"
                                              IsChecked="{Binding McpServerSettings.Stateless}"
                                              Margin="0,12,0,0" />
                                    <TextBlock Text="The server binds to this computer only. Remote network binding is intentionally unavailable until transport security and remote authorization are configured."
                                               Foreground="#F6C85F"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Margin="0,8,0,0" />

                                    <TextBlock Text="Settings file"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding McpServerSettings.SettingsPath}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               FontSize="11" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Exported Tools"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Only checked tools are advertised to MCP clients. Every tool starts off, including memory, reminders, internet, and local files."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Margin="0,4,0,10" />
                                </StackPanel>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding McpServerSettings.Tools}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#14191C"
                                                    BorderBrush="{StaticResource BorderBrushDark}"
                                                    BorderThickness="1"
                                                    Padding="10"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <CheckBox Content="{Binding Name}"
                                                              IsChecked="{Binding Enabled}"
                                                              FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               TextWrapping="Wrap"
                                                               FontSize="11"
                                                               Margin="22,3,0,0" />
                                                    <TextBlock Text="{Binding SafetySummary}"
                                                               Foreground="#F6C85F"
                                                               TextWrapping="Wrap"
                                                               FontSize="10"
                                                               Margin="22,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button Content="Reload"
                                Command="{Binding McpServerSettings.ReloadCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Start"
                                Command="{Binding McpServerSettings.StartCommand}"
                                AutomationProperties.AutomationId="SettingsMcpServerStartButton"
                                Margin="0,0,8,0" />
                        <Button Content="Stop"
                                Command="{Binding McpServerSettings.StopCommand}"
                                AutomationProperties.AutomationId="SettingsMcpServerStopButton"
                                Margin="0,0,8,0" />
                        <Button Content="Restart"
                                Command="{Binding McpServerSettings.RestartCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Protocol Test"
                                Command="{Binding McpServerSettings.TestCommand}"
                                AutomationProperties.AutomationId="SettingsMcpServerTestButton"
                                Margin="0,0,8,0" />
                        <Button Content="Save &amp; Apply"
                                Command="{Binding McpServerSettings.SaveAndApplyCommand}"
                                AutomationProperties.AutomationId="SettingsMcpServerSaveButton"
                                BorderBrush="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Local Knowledge"
                     AutomationProperties.AutomationId="SettingsLocalKnowledgeTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBackgroundBrush}">
                    <StackPanel Margin="12" DataContext="{Binding LocalKnowledgeSettings}">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Local Knowledge" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Native Qdrant retrieval with Tree-sitter structural code indexing and safe text fallbacks. Existing Ali and MCP tool contracts remain unchanged."
                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,20,0" />
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,20,0"
                                               AutomationProperties.AutomationId="SettingsLocalKnowledgeStatusText" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <CheckBox Content="Enable local knowledge" IsChecked="{Binding Enabled}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding RuntimeState}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Qdrant Service" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                                <WrapPanel Margin="0,0,0,10">
                                    <CheckBox Content="Ali manages local Qdrant" IsChecked="{Binding UseManagedLocalQdrant}" Margin="0,0,20,0" />
                                    <CheckBox Content="Start automatically when needed" IsChecked="{Binding AutoStartQdrant}" Margin="0,0,20,0" />
                                    <CheckBox Content="TLS (external service)" IsChecked="{Binding QdrantUseTls}" />
                                    <CheckBox Content="Use ripgrep exact-text lane" IsChecked="{Binding EnableRipgrep}" Margin="20,0,0,0" />
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Host" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding QdrantHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,12,3" />
                                    <TextBlock Grid.Column="2" Text="HTTP port" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding QdrantHttpPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Text="Collection" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding QdrantCollectionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,12,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="gRPC port" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding QdrantGrpcPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Text="API key env" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding QdrantApiKeyEnvironmentVariable, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" ToolTip="Ali reads the secret from this environment variable; the key is never stored in settings." />
                                </Grid>
                                <TextBlock Text="{Binding Statistics}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding QdrantDataPath, StringFormat=Data: {0}}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Test Connection" Command="{Binding TestCommand}" Margin="0,0,8,0" />
                                    <Button Content="Start" Command="{Binding StartCommand}" Margin="0,0,8,0" />
                                    <Button Content="Stop Ali-owned" Command="{Binding StopCommand}" Margin="0,0,8,0" />
                                    <Button Content="Open Dashboard" Command="{Binding OpenDashboardCommand}" Margin="0,0,8,0" />
                                    <Button Content="Refresh Status" Command="{Binding RefreshCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Approved Library and Embeddings" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="Library folder" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,8,3" />
                                    <Button Grid.Column="2" Content="Choose" Command="{Binding ChooseFolderCommand}" Margin="0,3,8,3" /><Button Grid.Column="3" Content="Open" Command="{Binding OpenFolderCommand}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Text="Embedding URL" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EmbeddingEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Text="Model" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EmbeddingModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Text="Scan / results" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,3">
                                        <TextBox Width="70" Text="{Binding ScanIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text=" min     return " VerticalAlignment="Center" Margin="5,0" /><TextBox Width="55" Text="{Binding MaxRetrievedChunks, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text=" chunks" VerticalAlignment="Center" Margin="5,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="C# is split by Tree-sitter declarations. Other supported text remains searchable through bounded overlapping chunks. Rebuild is required after changing embedding models."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Save" Command="{Binding SaveCommand}" BorderBrush="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                    <Button Content="Scan Now" Command="{Binding ScanCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="SettingsLocalKnowledgeScanButton" />
                                    <Button Content="Rebuild Collection" Command="{Binding RebuildCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding SettingsPath, StringFormat=Settings: {0}}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="InternetTab"
                     Header="Internet"
                     AutomationProperties.AutomationId="SettingsInternetTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBackgroundBrush}">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,12,10,0">
                        <StackPanel>
                            <TextBlock Text="Internet Source Backend"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding InternetBackendStatusText}"
                                       AutomationProperties.AutomationId="SettingsInternetBackendStatusText"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Sources" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding ConfiguredSourcesText}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2"
                                        Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Topics" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding ConfiguredTopicsText}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <CheckBox Content="Enable internet source backend"
                                      AutomationProperties.AutomationId="SettingsInternetBackendEnabledCheckBox"
                                      IsChecked="{Binding InternetBackendEnabled}"
                                      Margin="0,0,0,12" />

                            <Border Background="#101D18"
                                    BorderBrush="#2E8B57"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Google Grounded Search"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#78E0A3" />
                                    <TextBlock Text="Primary live-search provider. Ali always uses the pinned gemini-3.5-flash-lite model and accepts source URLs only from Google's grounding metadata."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Margin="0,3,0,8" />
                                    <Border Background="#171B20"
                                            BorderBrush="#C4932F"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="10"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="Owner-protected billing controls"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFD27A" />
                                                <TextBlock Text="{Binding GoogleBillingProtectionStatusText}"
                                                           AutomationProperties.AutomationId="SettingsGoogleBillingProtectionStatus"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Change password"
                                                        AutomationProperties.AutomationId="SettingsChangeGoogleBillingPasswordButton"
                                                        Click="ChangeGoogleBillingPasswordClicked"
                                                        IsEnabled="{Binding CanChangeGoogleBillingPassword}"
                                                        Margin="0,0,8,0" />
                                                <Button Content="{Binding GoogleBillingProtectionActionText}"
                                                        AutomationProperties.AutomationId="SettingsGoogleBillingProtectionButton"
                                                        Click="GoogleBillingProtectionClicked"
                                                        MinWidth="150"
                                                        Margin="0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <CheckBox Content="Enable Google grounded search"
                                              IsChecked="{Binding InternetGeminiGroundedSearchEnabled}"
                                              IsEnabled="{Binding CanEditGoogleBillingSettings}"
                                              AutomationProperties.AutomationId="SettingsInternetGeminiEnabledCheckBox"
                                              Margin="0,0,0,8" />
                                    <TextBlock Text="Gemini API key" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox x:Name="GeminiApiKeyPasswordBox"
                                                 PasswordChanged="GeminiApiKeyPasswordChanged"
                                                 IsEnabled="{Binding CanEditGoogleBillingSettings}"
                                                 AutomationProperties.AutomationId="SettingsInternetGeminiApiKeyPasswordBox"
                                                 Margin="0,2,0,2" />
                                    <TextBlock Text="Leave blank to use GEMINI_API_KEY. The key selects the project; Ali's pinned request selects the inexpensive grounded model. Never paste this key into a chat."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Requests/hour" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding InternetGeminiHourlyLimitText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanEditGoogleBillingSettings}"
                                                     AutomationProperties.AutomationId="SettingsInternetGeminiHourlyLimitTextBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Requests/day" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding InternetGeminiDailyLimitText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanEditGoogleBillingSettings}"
                                                     AutomationProperties.AutomationId="SettingsInternetGeminiDailyLimitTextBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Monthly breaker ($)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding InternetGeminiMonthlySpendLimitText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanEditGoogleBillingSettings}"
                                                     AutomationProperties.AutomationId="SettingsInternetGeminiMonthlySpendLimitTextBox" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Defaults: 30/hour, 150/day, and a $5 local estimated-spend breaker. Keep Google's project spend cap enabled as the independent second safety layer."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding InternetGeminiUsageText}"
                                               AutomationProperties.AutomationId="SettingsInternetGeminiUsageText"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,5,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Button Content="Test Google Grounding"
                                                AutomationProperties.AutomationId="SettingsInternetTestGeminiButton"
                                                Command="{Binding TestGeminiInternetBackendCommand}"
                                                MinWidth="158"
                                                Margin="0,0,8,0" />
                                        <Button Content="Refresh usage"
                                                AutomationProperties.AutomationId="SettingsInternetRefreshGeminiUsageButton"
                                                Click="RefreshGeminiUsageClicked"
                                                MinWidth="110" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Tavily API key" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InternetTavilyApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="SettingsInternetTavilyApiKeyTextBox"
                                     Margin="0,2,0,2" />
                            <TextBlock Text="Primary current-events, weather, and news search. Leave blank to use TAVILY_API_KEY from the environment."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding InternetTavilyUsageText}"
                                       AutomationProperties.AutomationId="SettingsInternetTavilyUsageText"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0" />
                            <Button Content="Test Tavily"
                                    AutomationProperties.AutomationId="SettingsInternetTestTavilyButton"
                                    Command="{Binding TestTavilyInternetBackendCommand}"
                                    HorizontalAlignment="Left"
                                    MinWidth="112"
                                    Margin="0,6,0,12" />

                            <TextBlock Text="Firecrawl API key" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InternetFirecrawlApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="SettingsInternetFirecrawlApiKeyTextBox"
                                     Margin="0,2,0,2" />
                            <TextBlock Text="Page extraction and first fallback search. Leave blank to use FIRECRAWL_API_KEY from the environment."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding InternetFirecrawlUsageText}"
                                       AutomationProperties.AutomationId="SettingsInternetFirecrawlUsageText"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0" />
                            <Button Content="Test Firecrawl"
                                    AutomationProperties.AutomationId="SettingsInternetTestFirecrawlButton"
                                    Command="{Binding TestFirecrawlInternetBackendCommand}"
                                    HorizontalAlignment="Left"
                                    MinWidth="122"
                                    Margin="0,6,0,12" />

                            <TextBlock Text="Brave Search API key" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InternetBraveSearchApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="SettingsInternetBraveSearchApiKeyTextBox"
                                     Margin="0,2,0,2" />
                            <TextBlock Text="Second fallback search. Leave blank to use BRAVE_SEARCH_API_KEY from the environment."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding InternetBraveSearchUsageText}"
                                       AutomationProperties.AutomationId="SettingsInternetBraveSearchUsageText"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0" />
                            <Button Content="Test Brave"
                                    AutomationProperties.AutomationId="SettingsInternetTestBraveSearchButton"
                                    Command="{Binding TestBraveSearchInternetBackendCommand}"
                                    HorizontalAlignment="Left"
                                    MinWidth="112"
                                    Margin="0,6,0,12" />

                            <TextBlock Text="Serper API key" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InternetSerperApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="SettingsInternetSerperApiKeyTextBox"
                                     Margin="0,2,0,2" />
                            <TextBlock Text="Final fallback Google results API. Leave blank to use SERPER_API_KEY from the environment."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding InternetSerperUsageText}"
                                       AutomationProperties.AutomationId="SettingsInternetSerperUsageText"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0" />
                            <Button Content="Test Serper"
                                    AutomationProperties.AutomationId="SettingsInternetTestSerperButton"
                                    Command="{Binding TestSerperInternetBackendCommand}"
                                    HorizontalAlignment="Left"
                                    MinWidth="112"
                                    Margin="0,6,0,12" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="Save"
                                        Command="{Binding SaveInternetBackendSettingsCommand}"
                                        Width="86"
                                        Margin="0,0,8,0" />
                                <Button Content="Test primary"
                                        AutomationProperties.AutomationId="SettingsInternetTestConfiguredButton"
                                        Command="{Binding TestConfiguredInternetBackendsCommand}"
                                        MinWidth="126"
                                        Margin="0" />
                            </StackPanel>

                            <Border BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    Padding="10"
                                    Margin="0,12,0,0">
                                <TextBlock Text="{Binding InternetBackendSettingsPath}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Integrations"
                     AutomationProperties.AutomationId="SettingsIntegrationsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <Border Background="#111D22"
                                BorderBrush="#246477"
                                BorderThickness="1"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Editor docking bay"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Ali detects editors instead of binding herself to a specific release. Refresh after a Notepad++ or Visual Studio update, then repair only the integration layer that needs it."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Notepad++"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Trusted lightweight editor toolkit: comparisons, JSON, XML, Markdown, CSV, spelling, folder navigation, and command hooks. Official catalog packages are SHA-256 verified before installation."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,5,0,10" />
                                <WrapPanel>
                                    <Button Content="Install / repair Notepad++ toolkit"
                                            Command="{Binding InstallNotepadPlusPlusToolkitCommand}"
                                            AutomationProperties.AutomationId="SettingsInstallNotepadPlusPlusToolkitButton"
                                            Background="#006C83"
                                            BorderBrush="#00BEE6"
                                            MinWidth="230"
                                            Margin="0,0,8,8" />
                                    <Button Content="Refresh status"
                                            Command="{Binding RefreshEditorIntegrationsCommand}"
                                            AutomationProperties.AutomationId="SettingsRefreshEditorIntegrationsButton"
                                            MinWidth="120"
                                            Margin="0,0,8,8" />
                                    <Button Content="Open integration guide"
                                            Command="{Binding OpenEditorIntegrationGuideCommand}"
                                            AutomationProperties.AutomationId="SettingsOpenEditorIntegrationGuideButton"
                                            MinWidth="150"
                                            Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Padding="14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Visual Studio"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Ali discovers side-by-side Visual Studio installations through Microsoft's inventory and uses the installed IDE, MSBuild, MSVC, CMake, test, debugger, and LLVM components without patching Visual Studio. Roslyn, LSP, DAP, and Ali's other coding tools remain modular and editor-independent."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding EditorIntegrationSummary}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,8" />
                        <TextBox Text="{Binding EditorIntegrationDetails, Mode=OneWay}"
                                 AutomationProperties.AutomationId="SettingsEditorIntegrationDetails"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 MinHeight="170"
                                 Padding="10"
                                 Margin="0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About"
                     AutomationProperties.AutomationId="SettingsAboutTab">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#111D22"
                            BorderBrush="#246477"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                <TextBlock Text="What's New in Software Engineering"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Ask Ali for a current, source-backed radar covering useful libraries, frameworks, languages, tools, design patterns, security changes, and engineering practices. Ali will recommend and explain; she will not install or upgrade anything from this report."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,7,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Show me what's new"
                                    Command="{Binding SoftwareEngineeringRadarCommand}"
                                    AutomationProperties.AutomationId="SettingsSoftwareEngineeringRadarButton"
                                    Background="#006C83"
                                    BorderBrush="#00BEE6"
                                    MinWidth="170"
                                    VerticalAlignment="Center"
                                    Margin="0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="With gratitude"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding TechnologyAcknowledgementsSummary}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,12,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Refresh inventory"
                                Command="{Binding RefreshTechnologyAcknowledgementsCommand}"
                                AutomationProperties.AutomationId="SettingsRefreshTechnologyInventoryButton"
                                VerticalAlignment="Bottom"
                                Margin="0" />
                    </Grid>

                    <TextBox Grid.Row="2"
                             Text="{Binding TechnologyAcknowledgementsText, Mode=OneWay}"
                             AutomationProperties.AutomationId="SettingsTechnologyAcknowledgementsText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="12"
                             Margin="0"
                             ToolTip="Generated from this build's real modules, resolved package graph, runtime assets, and coding-toolchain manifests." />
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>

