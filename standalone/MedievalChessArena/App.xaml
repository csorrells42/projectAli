<Application x:Class="MedievalChessArena.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Iron" Color="#FF141316"/>
        <SolidColorBrush x:Key="Parchment" Color="#FFF0D9A5"/>
        <SolidColorBrush x:Key="RoyalGold" Color="#FFD6A84B"/>
        <SolidColorBrush x:Key="BloodRed" Color="#FF7D1E24"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFF7E8C5"/>
            <Setter Property="Background" Value="#FF302A2A"/>
            <Setter Property="BorderBrush" Value="#FF9C783D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFF7E8C5"/>
            <Setter Property="Background" Value="#FF181619"/>
            <Setter Property="BorderBrush" Value="#FF806238"/>
            <Setter Property="Padding" Value="7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FF221A16"/>
            <Setter Property="Background" Value="#FFF0D9A5"/>
            <Setter Property="BorderBrush" Value="#FF806238"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Application.Resources>
</Application>
