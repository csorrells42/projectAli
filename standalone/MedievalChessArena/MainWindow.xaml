<Window x:Class="MedievalChessArena.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Medieval Chess Arena" Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#FF0D0C0F" Foreground="#FFF4E5C2">
    <Window.Resources>
        <LinearGradientBrush x:Key="Banner" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF171318" Offset="0"/><GradientStop Color="#FF4A1D22" Offset=".5"/><GradientStop Color="#FF171318" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#D91B181D"/><Setter Property="BorderBrush" Value="#FF715631"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="6"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Banner}" BorderBrush="#FFD2A24B" BorderThickness="0,0,0,2">
            <Grid Margin="22,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="MEDIEVAL CHESS ARENA" FontFamily="Georgia" FontSize="28" FontWeight="Bold" Foreground="#FFFFD980"/>
                    <TextBlock Text="One board. Three minds. No quarter." Foreground="#FFD5BE92" FontStyle="Italic"/></StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="TurnText" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="StatusText" Foreground="#FFFFC65D" HorizontalAlignment="Right"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="COMMANDERS" FontFamily="Georgia" FontSize="18" Foreground="#FFFFD980" Margin="0,0,0,10"/>
                    <TextBlock Text="White host"/><ComboBox x:Name="WhiteController" Margin="0,4,0,10" SelectionChanged="ControllerChanged"><ComboBoxItem IsSelected="True">Human</ComboBoxItem><ComboBoxItem>Codex</ComboBoxItem><ComboBoxItem>Ali</ComboBoxItem></ComboBox>
                    <TextBlock Text="Black host"/><ComboBox x:Name="BlackController" Margin="0,4,0,4" SelectionChanged="ControllerChanged"><ComboBoxItem>Human</ComboBoxItem><ComboBoxItem>Codex</ComboBoxItem><ComboBoxItem IsSelected="True">Ali</ComboBoxItem></ComboBox>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ISSUE AN ORDER" FontFamily="Georgia" FontSize="18" Foreground="#FFFFD980"/>
                    <TextBlock Text="Click a piece and destination, or enter UCI coordinates." Foreground="#FFBCA77E" Margin="0,4,0,8"/>
                    <TextBox x:Name="MoveBox" Text="e2e4" FontFamily="Consolas" FontSize="17" KeyDown="MoveBoxKeyDown"/>
                    <Button Content="Make move" Click="SubmitMove" Margin="0,8,0,0"/>
                    <TextBlock x:Name="MoveMessage" Margin="0,8,0,0" Foreground="#FFFFC76A"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BATTLE CONTROLS" FontFamily="Georgia" FontSize="18" Foreground="#FFFFD980"/>
                    <WrapPanel Margin="0,7,0,0"><Button Content="New battle" Click="ResetGame"/><Button Content="Turn board" Click="FlipBoard"/><Button Content="Export PGN" Click="ExportPgn"/></WrapPanel>
                </StackPanel></Border>
            </StackPanel>

            <Border Grid.Column="1" Margin="8,3" BorderBrush="#FFB78942" BorderThickness="2" CornerRadius="6" Background="#FF09090B">
                <Grid ClipToBounds="True">
                    <Viewport3D x:Name="ArenaViewport" MouseLeftButtonDown="BoardClicked">
                        <Viewport3D.Camera><PerspectiveCamera x:Name="ArenaCamera" Position="0,9.8,-10.7" LookDirection="0,-8.4,10.2" UpDirection="0,1,0" FieldOfView="43"/></Viewport3D.Camera>
                        <ModelVisual3D x:Name="SceneVisual"/>
                    </Viewport3D>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#B5100E12" CornerRadius="0,4,0,0" Padding="10,5">
                        <TextBlock x:Name="SelectionText" Foreground="#FFFFD477" Text="Choose your champion."/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="CHRONICLE OF MOVES" FontFamily="Georgia" FontSize="18" Foreground="#FFFFD980" Margin="0,0,0,8"/>
                    <ListBox x:Name="MoveHistory" Grid.Row="1" Background="#FF111014" Foreground="#FFF0DBB2" BorderBrush="#FF624B2C" FontFamily="Consolas" FontSize="14"/>
                </Grid></Border>
                <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="AI WAR GATES" FontFamily="Georgia" FontSize="18" Foreground="#FFFFD980"/>
                    <TextBlock Text="CODEX WAR GATE" FontWeight="Bold" Foreground="#FF73C8FF" Margin="0,7,0,0"/>
                    <TextBlock x:Name="CodexGateState" Text="Opening Codex gate…" Foreground="#FFFFC35A"/>
                    <TextBox x:Name="CodexMcpEndpointText" IsReadOnly="True" FontSize="11" Margin="0,3,0,0"/>
                    <TextBlock Text="ALI WAR GATE" FontWeight="Bold" Foreground="#FFC78BFF" Margin="0,9,0,0"/>
                    <TextBlock x:Name="AliGateState" Text="Opening Ali gate…" Foreground="#FFFFC35A"/>
                    <TextBox x:Name="AliMcpEndpointText" IsReadOnly="True" FontSize="11" Margin="0,3,0,0"/>
                    <TextBlock Text="Shared spectator API" Foreground="#FFB79F74" Margin="0,9,0,0"/><TextBox x:Name="ApiEndpointText" IsReadOnly="True" FontSize="11"/>
                    <TextBlock Text="Each fighter is identity-bound to its own gate. Both move on this one authoritative board." Foreground="#FFBFAE8D" Margin="0,7,0,0"/>
                </StackPanel></Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#FF171419" BorderBrush="#FF5C472A" BorderThickness="0,1,0,0">
            <Grid Margin="16,0"><TextBlock x:Name="FooterText" VerticalAlignment="Center" Foreground="#FFC7B58D"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FF7CD6A4" Text="Local-only arena • REST + MCP • standard chess rules"/></Grid>
        </Border>
    </Grid>
</Window>
